---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import BookCta from '../components/BookCta.astro';

// Runs entirely in the browser: nothing typed here is stored or sent.
const WEEKS_PER_YEAR = 50;

const fieldset = 'border:1px solid var(--border);border-radius:14px;padding:24px;margin:0;background:var(--color-surface);';
const legend = "font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);padding:0 8px;margin-left:-8px;";
const help = 'font-size:13.5px;line-height:1.5;color:var(--color-muted);margin:8px 0 0;';
const row = 'display:flex;justify-content:space-between;gap:16px;font-size:15px;color:var(--color-body);padding:12px 0;border-bottom:1px solid var(--border);';
---
<Base
  title="Automation Payback Calculator — Frontier MFG"
  description="A quick, rough check on whether an automation project pays for itself: enter labour, scrap, and downtime savings and the project cost to get a payback period."
  breadcrumb={[['Payback Calculator', '/payback-calculator']]}
>
  <Header />
  <main>

    <PageHero
      eyebrow="Payback calculator"
      title="Will it pay for itself?"
      lead="A rough check on an automation project. Enter what it would save and what it would cost. Nothing you type is stored or sent anywhere; it all stays in your browser."
    />

    <section class="dots-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,96px) 32px;display:flex;flex-wrap:wrap;gap:32px;align-items:flex-start;">

        <form id="calc" novalidate style="flex:1 1 520px;min-width:min(100%,300px);display:flex;flex-direction:column;gap:20px;">
          <fieldset style={fieldset}>
            <legend style={legend}>Labour</legend>
            <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
              <div style="flex:1 1 200px;">
                <label for="labour-hours" class="form-label">Labour hours saved per week</label>
                <input id="labour-hours" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class="input-dark" />
              </div>
              <div style="flex:1 1 200px;">
                <label for="labour-rate" class="form-label">Burdened labour rate ($/hour)</label>
                <input id="labour-rate" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class="input-dark" />
              </div>
            </div>
            <p style={help}>Burdened rate means the full cost of an hour of labour: wages plus benefits, payroll costs, and overhead.</p>
          </fieldset>

          <fieldset style={fieldset}>
            <legend style={legend}>Scrap</legend>
            <div style="margin-top:8px;">
              <label for="scrap" class="form-label">Scrap cost reduced per month ($)</label>
              <input id="scrap" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class="input-dark" />
            </div>
          </fieldset>

          <fieldset style={fieldset}>
            <legend style={legend}>Downtime</legend>
            <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
              <div style="flex:1 1 200px;">
                <label for="down-hours" class="form-label">Downtime hours reduced per month</label>
                <input id="down-hours" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class="input-dark" />
              </div>
              <div style="flex:1 1 200px;">
                <label for="down-value" class="form-label">Value of lost output ($/hour)</label>
                <input id="down-value" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class="input-dark" />
              </div>
            </div>
            <label style="display:flex;gap:12px;align-items:flex-start;margin-top:18px;font-size:15.5px;line-height:1.5;color:var(--color-text);cursor:pointer;">
              <input id="bottleneck" type="checkbox" style="width:20px;height:20px;margin:2px 0 0;flex-shrink:0;accent-color:var(--color-accent);" />
              This machine limits our total output.
            </label>
            <p style={help}>Extra uptime only makes money if this machine is the bottleneck. If something else limits your output, more uptime here just means more waiting, so downtime savings only count when this box is ticked.</p>
          </fieldset>

          <fieldset style={fieldset}>
            <legend style={legend}>Project</legend>
            <div style="margin-top:8px;">
              <label for="cost" class="form-label">Estimated project cost ($)</label>
              <input id="cost" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class="input-dark" />
            </div>
          </fieldset>
        </form>

        <aside class="calc-results" aria-labelledby="results-title" style="flex:1 1 340px;min-width:min(100%,300px);">
          <div style="background:var(--color-bg-alt);border:1px solid var(--border-hard);border-radius:16px;padding:28px;">
            <h2 id="results-title" style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-muted);font-weight:500;margin:0 0 8px;">Your estimate</h2>
            <div aria-live="polite">
              <div style={row}><span>Labour, per year</span><span id="out-labour" style="color:var(--color-text);font-family:'IBM Plex Mono',monospace;">—</span></div>
              <div style={row}><span>Scrap, per year</span><span id="out-scrap" style="color:var(--color-text);font-family:'IBM Plex Mono',monospace;">—</span></div>
              <div style={row}><span>Downtime, per year</span><span id="out-down" style="color:var(--color-text);font-family:'IBM Plex Mono',monospace;text-align:right;">—</span></div>
              <div style="padding:22px 0 0;">
                <div style="font-size:14px;color:var(--color-muted);margin-bottom:6px;">Estimated annual savings</div>
                <div id="out-total" style="font-size:clamp(30px,4vw,40px);font-weight:600;letter-spacing:-0.02em;color:var(--color-text);">—</div>
              </div>
              <div style="padding:20px 0 0;">
                <div style="font-size:14px;color:var(--color-muted);margin-bottom:6px;">Payback period</div>
                <div id="out-payback" style="font-size:clamp(30px,4vw,40px);font-weight:600;letter-spacing:-0.02em;color:var(--color-accent-text);">—</div>
                <div id="out-payback-note" style="font-size:14px;color:var(--color-muted);margin-top:6px;min-height:21px;"></div>
              </div>
            </div>
            <p style="font-size:14px;line-height:1.6;color:var(--color-body);margin:22px 0 0;padding:14px 16px;border-radius:10px;background:var(--glass);border:1px solid var(--border);">
              <strong style="color:var(--color-text);">This is a rough estimate.</strong> It's only as good as the numbers you enter. A Productivity Assessment replaces them with measured data from your floor. Labour savings assume {WEEKS_PER_YEAR} working weeks a year.
            </p>
          </div>
        </aside>

      </div>
    </section>

    <BookCta title="Get the real numbers." copy="A Productivity Assessment measures your labour, scrap, and downtime on your floor, so the payback estimate rests on data instead of guesses." />

  </main>
  <Footer />
</Base>

<script define:vars={{ WEEKS_PER_YEAR }}>
  const $ = (id) => document.getElementById(id);
  const num = (id) => Math.max(0, parseFloat($(id).value) || 0);
  const money = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });
  const anyInput = () => ['labour-hours', 'labour-rate', 'scrap', 'down-hours', 'down-value', 'cost'].some((id) => $(id).value !== '');

  function update() {
    const labour = num('labour-hours') * num('labour-rate') * WEEKS_PER_YEAR;
    const scrap = num('scrap') * 12;
    const downRaw = num('down-hours') * num('down-value') * 12;
    const counted = $('bottleneck').checked;
    const down = counted ? downRaw : 0;
    const total = labour + scrap + down;
    const cost = num('cost');

    if (!anyInput()) {
      ['out-labour', 'out-scrap', 'out-down', 'out-total', 'out-payback'].forEach((id) => ($(id).textContent = '—'));
      $('out-payback-note').textContent = '';
      return;
    }

    $('out-labour').textContent = money.format(labour);
    $('out-scrap').textContent = money.format(scrap);
    $('out-down').textContent = counted ? money.format(down) : downRaw > 0 ? 'Not counted' : money.format(0);
    $('out-total').textContent = money.format(total);

    if (total <= 0) {
      $('out-payback').textContent = '—';
      $('out-payback-note').textContent = 'Enter some savings to see a payback period.';
    } else if (cost <= 0) {
      $('out-payback').textContent = '—';
      $('out-payback-note').textContent = 'Enter a project cost to see a payback period.';
    } else {
      const months = cost / (total / 12);
      $('out-payback').textContent = `${months.toFixed(1)} months`;
      $('out-payback-note').textContent = months >= 12 ? `About ${(months / 12).toFixed(1)} years` : '';
    }
  }

  const form = $('calc');
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>
