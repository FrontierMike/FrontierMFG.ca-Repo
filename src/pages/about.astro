---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookCta from '../components/BookCta.astro';
import DimensionLine from '../components/DimensionLine.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';
---
<Base
  title="About Mike Wait — Frontier MFG"
  description="I help BC manufacturers modernize the equipment they already have. I measure where time and output are going, then automate the parts that pay back fastest."
  breadcrumb={[['About', '/about']]}
>
  <Header />
  <main>

    <section class="band-dark blueprint" style="border-bottom:1px solid var(--line);">
      <div class="wrap" style="padding-block:clamp(64px,9vw,120px);">
        <div class="label" style="margin-bottom:22px;">About</div>
        <div style="max-width:980px;">
          <h1 class="display h1" style="font-size:clamp(2.75rem,1.8rem+4vw,4.5rem);">I help BC manufacturers modernize the equipment they already have.</h1>
          <DimensionLine class="mt-6" />
        </div>
        <p class="lead" style="margin-top:26px;max-width:680px;font-size:1.3rem;">I measure where time and output are going, then automate the parts that pay back fastest.</p>
      </div>
    </section>

    <section class="band-light blueprint section">
      <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,320px)_minmax(0,1fr)] items-start">
        <!-- TODO: photo — a portrait of Mike, ideally on a shop floor, replaces
             the monogram tile. -->
        <div class="card" data-reveal style="padding:28px;display:flex;align-items:center;gap:18px;">
          <div aria-hidden="true" style="width:72px;height:72px;flex-shrink:0;border-radius:4px;background:var(--color-ink);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:22px;font-weight:500;color:var(--color-paper);position:relative;">MW<span style="position:absolute;top:9px;right:9px;width:7px;height:7px;background:var(--color-safety);transform:rotate(45deg);"></span></div>
          <div>
            <div class="h3">Mike Wait</div>
            {/* Credentials line. TODO: Mike to write. Any title must show
                "EIT" with equal prominence. */}
            <div class="label" style="margin-top:6px;">Founder · B.Eng, EIT</div>
          </div>
        </div>
        <div>
          <div class="label" style="margin-bottom:16px;" data-reveal>Background</div>
          <CredentialsStrip />
        </div>
      </div>
    </section>

    <BookCta title="Let's look at your numbers." copy="Book a Productivity Assessment and I'll walk your floor, talk to your operators, and show you where the time and output are going." />

  </main>
  <Footer />
</Base>
