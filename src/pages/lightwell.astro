---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const loadBars = [82, 64, 86, 70, 88, 60, 84, 68, 90, 72, 85, 66];

const stats = [
  { label: 'Parts (session)', value: '426', color: '#73bf69' },
  { label: 'Parts / min', value: '3.9', color: '#73bf69' },
  { label: 'Downtime (24 h)', value: '40', unit: ' mins', color: '#f2495c' },
  { label: 'Availability', value: '90.4', unit: ' %', color: '#73bf69' },
];

const videos = [
  { src: 'lightwell-demo-1', caption: 'DASHBOARD — LIVE VIEW' },
  { src: 'lightwell-demo-2', caption: 'SENSOR DETAIL' },
  { src: 'lightwell-demo-3', caption: 'TREND HISTORY' },
  { src: 'lightwell-demo-4', caption: 'ALERTS & STOPPAGES' },
];

const terms = [
  { n: 'Term 01', title: "What's a KPI?", copy: 'A "Key Performance Indicator" is simply a number that tells you whether things are going well — like parts per hour, scrap rate, or on-time shipments.', why: 'the right few numbers, tracked honestly, keep everyone pointed at the same goal.' },
  { n: 'Term 02', title: "What's OEE?", copy: '"Overall Equipment Effectiveness" rolls three things — how often a machine runs, how fast, and how many good parts it makes — into one honest score out of 100%.', why: 'most plants sit near 60%. Every point you recover is capacity you already paid for.' },
  { n: 'Term 03', title: "What's Industrial IoT?", copy: 'The "Industrial Internet of Things" just means factory equipment that\'s connected and can report on itself — sensors and machines sending data automatically instead of someone writing it on a clipboard.', why: 'automatic data is accurate data. No more guessing or manual logs that take up valuable time.' },
  { n: 'Term 04', title: "What's a live dashboard?", copy: 'Screens — on the floor, in the office, or on your phone — that show your KPIs updating in real time, instead of a report you get days later.', why: 'you can act on a problem while the shift is still running, not after it\'s over.' },
  { n: 'Term 05', title: 'Where does my data live?', copy: 'In the Lightwell database, running on a small computer we install in your shop — not in the cloud. The sensors write to it around the clock and the dashboard reads from it, all over your own network.', why: 'your production data never leaves the building, and there is nothing for you to administer.' },
];

const benefits = [
  { title: 'Find lost hours', copy: 'Downtime is the silent profit killer. When every stoppage is logged automatically, the real cost of small, "normal" interruptions finally becomes visible — and fixable.' },
  { title: 'End the guesswork', copy: "Quoting, scheduling, and hiring decisions get far easier when they're based on what your plant really produces — not on a hopeful estimate." },
  { title: 'Prove improvements', copy: 'Change a process and see the impact on the same dashboard the next shift. No more debating whether something "felt" better.' },
  { title: 'Win more work', copy: 'Increasingly, larger customers want suppliers who can show real production data. Being able to is becoming a competitive edge.' },
];

const how = [
  { n: '01', title: 'Place the Lightwell sensors', copy: 'Small wireless Lightwell sensors attach to your machines and plug into standard wall power. No rewiring, no shutdown, no disruption to production.' },
  { n: '02', title: 'Collect on-site', copy: 'They track cycles, run time, stoppages, and output around the clock — every reading landing in the Lightwell database on a small computer in your shop, with no clipboards or manual entry.' },
  { n: '03', title: 'See it live', copy: 'The Lightwell dashboard tracks, displays, and compares it all — on the floor, in the office, or on your phone, updating in real time.' },
  { n: '04', title: 'Act & improve', copy: "With Frontier's help, turn what you learn into concrete changes — and watch the numbers move." },
];

const faqs = [
  { q: 'Will this work with my older machines?', a: 'Yes. The sensors mount to equipment you already own and measure what\'s happening from the outside — no PLC upgrade or special controller needed. Manual, semi-automatic, and CNC all work.' },
  { q: 'Do I need IT people or a network project?', a: 'No. The Lightwell sensors are wireless and run on standard wall power, and the Lightwell dashboard opens in any browser. The Lightwell database runs on a small computer we install and look after — nothing for you to maintain, and no IT project.' },
  { q: 'How disruptive is installation?', a: 'Minimal. We place the sensors during a normal visit — no production downtime and nothing cut into or wired through your machines.' },
  { q: 'What can it actually track?', a: 'The metrics that show how the floor is really running: output and part counts, run vs. idle time, downtime and stoppages, cycle time, and OEE.' },
  { q: 'Is my production data private?', a: "Yes — and it stays in your building. The Lightwell database runs on-site, not in the cloud, so your production data never leaves your own network. You control who on your team can see the dashboard." },
  { q: "What if I'm not technical?", a: "That's exactly who Lightwell is for. The Lightwell dashboard is plain-language and built to read at a glance — no data team and no training course required." },
  { q: 'When does Lightwell launch?', a: "General availability is targeted for the end of the year. Pilot partners are onboarded first — that's happening now." },
];

const pilotBenefits = [
  { n: '01', title: 'Hands-on setup, done for you', copy: 'We install the Lightwell sensors, set up the database on-site, and stand up your dashboard for you.' },
  { n: '02', title: 'Shape the product', copy: 'Your feedback directly guides what we build next.' },
  { n: '03', title: 'First in line at launch', copy: 'Pilot partners get priority when Lightwell becomes generally available.' },
];
---
<Base
  title="Lightwell — Real-time KPI tracking — Frontier MFG"
  description="Lightwell: wireless Lightwell sensors feed an on-site Lightwell database, and the Lightwell dashboard tracks, displays and compares your shop-floor KPIs — OEE, output, downtime, cycle time. No cloud, no rewiring, no IT project. Coming soon from Frontier MFG."
  themeColor="#131c24"
>
  <Header page="lightwell" />
  <main>

    <!-- Hero -->
    <section style="background:#131c24;color:#fff;position:relative;overflow:hidden;">
      <div class="grid-dark-overlay"></div>
      <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,96px) 32px;position:relative;display:flex;flex-wrap:wrap;gap:56px;align-items:center;">
        <div style="flex:1 1 440px;min-width:300px;">
          <div style="display:inline-flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#b3261e;font-weight:500;margin-bottom:24px;background:rgba(179,38,30,0.12);border:1px solid rgba(179,38,30,0.35);padding:8px 15px;border-radius:100px;">
            <span class="pulse-dot" style="display:inline-block;width:7px;height:7px;border-radius:100px;background:#b3261e;"></span> Launching end of year — join the pilot
          </div>
          <h1 style="font-size:clamp(40px,5vw,66px);line-height:1.03;letter-spacing:-0.025em;font-weight:600;color:#fff;margin:0 0 22px;text-wrap:balance;">Lightwell: Real-time KPI tracking, made effortless.</h1>
          <p style="font-size:19px;line-height:1.6;color:#c3ccd3;margin:0 0 34px;max-width:540px;">Unobtrusive Lightwell sensors automatically track your key manufacturing metrics and stream them into the Lightwell database — right there in your shop — where the Lightwell dashboard turns them into a live picture of how your plant is actually running.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a href="#pilot" class="btn-red">Join the pilot <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
            <a href="#how" class="btn-ghost-dark">How it works</a>
          </div>
        </div>
        <!-- Live mockup -->
        <div style="flex:1 1 380px;min-width:300px;">
          <div style="background:#0a0e13;border:1px solid rgba(255,255,255,0.08);border-radius:14px;box-shadow:0 30px 60px -24px rgba(0,0,0,0.55);padding:14px;display:flex;flex-direction:column;gap:10px;">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0 2px 2px;font-family:'IBM Plex Mono',monospace;">
              <span style="display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:0.06em;color:#c3cad2;"><span class="pulse-dot" style="width:7px;height:7px;border-radius:100px;background:#73bf69;display:inline-block;"></span>LIGHTWELL · CNC-01</span>
              <span style="font-size:10px;letter-spacing:0.14em;color:#6b7079;">LIVE — RIGHT NOW</span>
            </div>
            <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:10px;">
              <div style="font-size:10px;color:#8b929b;margin-bottom:9px;">Machine status</div>
              <div style="background:linear-gradient(180deg,#67b25b,#469140);border-radius:5px;height:62px;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:600;letter-spacing:0.04em;color:#fff;">RUNNING</div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;">
              {stats.map((s) => (
                <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:12px;">
                  <div style="font-size:10px;color:#8b929b;margin-bottom:8px;">{s.label}</div>
                  <div style={`font-size:28px;font-weight:400;color:${s.color};line-height:1;`}>{s.value}{s.unit && <span style="font-size:14px;color:#8b929b;">{s.unit}</span>}</div>
                </div>
              ))}
            </div>
            <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:12px;">
              <div style="font-size:10px;color:#8b929b;margin-bottom:12px;">Machine load — live (%)</div>
              <div style="display:flex;gap:7px;">
                <div style="display:flex;flex-direction:column;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:8px;color:#5f656e;height:60px;"><span>80</span><span>40</span><span>0</span></div>
                <div style="flex:1;display:flex;align-items:flex-end;gap:3px;height:60px;border-left:1px solid rgba(255,255,255,0.07);border-bottom:1px solid rgba(255,255,255,0.09);padding-left:6px;">
                  {loadBars.map((h) => <div style={`flex:1;height:${h}%;background:#d9a520;border-top:2px solid #b7861a;`}></div>)}
                </div>
              </div>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0 2px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8b929b;"><span>4 sensors online</span><span style="color:#73bf69;">● healthy</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- What is Lightwell + videos -->
    <section class="lines-white">
      <div style="max-width:900px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;text-align:center;">
        <div class="eyebrow" style="margin-bottom:18px;">What is Lightwell</div>
        <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0 0 22px;">Most shops fly blind. Lightwell turns the lights on.</h2>
        <p style="font-size:19px;line-height:1.65;color:#566169;margin:0 auto;max-width:680px;">Ask most manufacturers how many good parts came off a line last Tuesday, or how much time was lost to stoppages, and the honest answer is a shrug or a stale spreadsheet. Lightwell is three parts working together: <strong>Lightwell sensors</strong> we place on your equipment, the <strong>Lightwell database</strong> they stream into on a small computer in your shop, and the <strong>Lightwell dashboard</strong> where it is all tracked, displayed and compared. Nothing goes to the cloud, and you open the dashboard on any screen — no rewiring, no IT project, no data team required.</p>
        <div style="display:flex;flex-direction:column;gap:0;margin-top:48px;text-align:left;border:1px solid #e6e9ec;border-radius:16px;overflow:hidden;">
          {videos.map((v) => (
            <div style="background:#131c24;position:relative;">
              <video src={`/${v.src}.mp4`} loop muted playsinline preload="none" data-lazyvid style="width:100%;height:auto;display:block;background:#0a0e13;"></video>
              <div style="position:absolute;left:14px;bottom:12px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.06em;color:#fff;background:rgba(14,22,29,0.72);padding:5px 10px;border-radius:6px;">{v.caption}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- New to this? Start here -->
    <section id="learn" class="lines-grey" style="border-top:1px solid #e6e9ec;border-bottom:1px solid #e6e9ec;">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:48px;">
          <div class="eyebrow" style="margin-bottom:18px;">New to this? Start here</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0 0 16px;">The jargon, in plain English.</h2>
          <p style="font-size:18px;line-height:1.6;color:#566169;margin:0;">You don't need to be technical to benefit from any of this. Here's what the terms actually mean — and why each one matters for your bottom line.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
          {terms.map((t) => (
            <div style="background:#fff;border:1px solid #e6e9ec;border-radius:14px;padding:30px;">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#b3261e;margin-bottom:14px;">{t.n}</div>
              <h3 style="font-size:21px;font-weight:600;color:#16202a;margin:0 0 12px;letter-spacing:-0.01em;">{t.title}</h3>
              <p style="font-size:15px;line-height:1.65;color:#566169;margin:0 0 14px;">{t.copy}</p>
              <p style="font-size:14px;line-height:1.6;color:#8a949d;margin:0;"><span style="color:#16202a;font-weight:600;">Why it matters:</span> {t.why}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="lines-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:52px;">
          <div class="eyebrow" style="margin-bottom:18px;">Why it matters</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0;">What clear data actually changes.</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:40px 48px;">
          {benefits.map((b) => (
            <div>
              <div style="font-size:34px;font-weight:600;color:#b3261e;letter-spacing:-0.02em;margin-bottom:10px;">{b.title}</div>
              <p style="font-size:15.5px;line-height:1.65;color:#566169;margin:0;">{b.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="lines-grey" style="border-top:1px solid #e6e9ec;border-bottom:1px solid #e6e9ec;">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:52px;">
          <div class="eyebrow" style="margin-bottom:18px;">How Lightwell works</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0;">Up and running, without the IT project.</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:32px;">
          {how.map((h) => (
            <div>
              <div style="width:56px;height:56px;border:1.5px solid #b3261e;border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:18px;color:#b3261e;margin-bottom:22px;">{h.n}</div>
              <h3 style="font-size:19px;font-weight:600;color:#16202a;margin:0 0 10px;">{h.title}</h3>
              <p style="font-size:15px;line-height:1.6;color:#566169;margin:0;">{h.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- And then... AI -->
    <section style="background:#131c24;color:#fff;">
      <div style="max-width:900px;margin:0 auto;padding:clamp(56px,7vw,88px) 32px;text-align:center;">
        <div class="eyebrow" style="margin-bottom:18px;">And then... AI</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);line-height:1.12;letter-spacing:-0.02em;font-weight:600;color:#fff;margin:0 0 20px;">Lightwell is your on-ramp to AI.</h2>
        <p style="font-size:18px;line-height:1.65;color:#c3ccd3;margin:0 auto;max-width:640px;">The reason AI feels out of reach for most shops is simple: AI needs data, and most shops don't have any. Once Lightwell is capturing clean, consistent production data, the door opens to genuinely useful AI — predicting maintenance before a breakdown, forecasting output, and spotting patterns no person would catch. Get the data right first, and AI stops being a buzzword and starts being an advantage.</p>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="lines-grey" style="border-top:1px solid #e6e9ec;border-bottom:1px solid #e6e9ec;">
      <div style="max-width:1000px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:48px;">
          <div class="tick" style="margin-bottom:16px;"></div>
          <div class="eyebrow" style="margin-bottom:18px;">Common questions</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0;">The questions shops actually ask.</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
          {faqs.map((f) => (
            <div style="background:#fff;border:1px solid #e6e9ec;border-radius:14px;padding:26px;">
              <h3 style="font-size:17px;font-weight:600;color:#16202a;margin:0 0 10px;">{f.q}</h3>
              <p style="font-size:15px;line-height:1.6;color:#566169;margin:0;">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pilot -->
    <section id="pilot" style="background:#ffffff;">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;display:flex;flex-wrap:wrap;gap:56px;">
        <div style="flex:1 1 380px;min-width:300px;">
          <div style="display:inline-flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#b3261e;font-weight:500;margin-bottom:22px;background:#fbe9e8;border:1px solid rgba(179,38,30,0.25);padding:7px 14px;border-radius:100px;">Limited pilot — a handful of BC shops</div>
          <h2 style="font-size:clamp(30px,3.6vw,48px);line-height:1.06;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0 0 20px;">Be one of the first to run on Lightwell.</h2>
          <p style="font-size:18px;line-height:1.65;color:#566169;margin:0 0 32px;max-width:480px;">We're partnering with a small group of Lower Mainland manufacturers to prove Lightwell on real shop floors. Pilot partners get early access, hands-on setup, and a direct say in where the product goes.</p>
          <div style="display:flex;flex-direction:column;gap:16px;">
            {pilotBenefits.map((p) => (
              <div style="display:flex;gap:14px;align-items:flex-start;"><span style="color:#b3261e;font-family:'IBM Plex Mono',monospace;margin-top:2px;">{p.n}</span><div><div style="font-size:16px;font-weight:600;color:#16202a;margin-bottom:3px;">{p.title}</div><div style="font-size:14.5px;line-height:1.6;color:#566169;">{p.copy}</div></div></div>
            ))}
          </div>
          <div style="margin-top:40px;">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8a949c;margin-bottom:14px;">Who's behind Lightwell</div>
            <div style="display:flex;flex-wrap:wrap;gap:12px 28px;">
              <a href="/#about" style="display:flex;align-items:center;gap:12px;color:#16202a;">
                <span style="width:46px;height:46px;border-radius:11px;background:#16202a;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:15px;color:#fff;position:relative;flex-shrink:0;">MW<span style="position:absolute;top:6px;right:6px;width:5px;height:5px;background:#b3261e;border-radius:1px;transform:rotate(45deg);"></span></span>
                <span><span style="display:block;font-size:15px;font-weight:600;">Mike Wait</span><span style="display:block;font-size:12.5px;color:#566169;">Founder — leads Lightwell</span></span>
              </a>
              <a href="/#about" style="display:flex;align-items:center;gap:12px;color:#16202a;">
                <span style="width:46px;height:46px;border-radius:11px;background:#16202a;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:15px;color:#fff;position:relative;flex-shrink:0;">GW<span style="position:absolute;top:6px;right:6px;width:5px;height:5px;background:#b3261e;border-radius:1px;transform:rotate(45deg);"></span></span>
                <span><span style="display:block;font-size:15px;font-weight:600;">Gord Wait</span><span style="display:block;font-size:12.5px;color:#566169;">Product-design advisor</span></span>
              </a>
            </div>
          </div>
        </div>
        <div style="flex:1 1 420px;min-width:300px;">
          <form id="pilot-form" style="background:#f5f7f9;border:1px solid #e6e9ec;border-radius:16px;padding:30px;">
            <h3 style="font-size:20px;font-weight:600;color:#16202a;margin:0 0 6px;">Apply to join the pilot</h3>
            <p style="font-size:14px;color:#566169;margin:0 0 22px;">Takes two minutes. We'll follow up within one business day.</p>
            <input type="text" name="company-website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;" />
            <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:14px;">
              <div style="flex:1 1 140px;">
                <label for="pf-name" class="form-label form-label-light">Name</label>
                <input id="pf-name" name="name" type="text" required class="input-light" />
              </div>
              <div style="flex:1 1 140px;">
                <label for="pf-company" class="form-label form-label-light">Company</label>
                <input id="pf-company" name="company" type="text" required class="input-light" />
              </div>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:14px;">
              <div style="flex:1 1 140px;">
                <label for="pf-email" class="form-label form-label-light">Email</label>
                <input id="pf-email" name="email" type="email" required class="input-light" />
              </div>
              <div style="flex:1 1 140px;">
                <label for="pf-machines" class="form-label form-label-light"># of machines</label>
                <select id="pf-machines" name="machines" class="input-light">
                  <option>1 – 5</option>
                  <option>6 – 15</option>
                  <option>16 – 40</option>
                  <option>40+</option>
                </select>
              </div>
            </div>
            <div style="margin-bottom:14px;">
              <label for="pf-make" class="form-label form-label-light">What do you make?</label>
              <input id="pf-make" name="make" type="text" required class="input-light" />
            </div>
            <div style="margin-bottom:20px;">
              <label for="pf-track" class="form-label form-label-light">What would you most want to track? (optional)</label>
              <textarea id="pf-track" name="track" rows="3" class="input-light" style="resize:vertical;"></textarea>
            </div>
            <button type="submit" class="btn-red" style="width:100%;">Apply to join the pilot</button>
            <p style="margin:12px 0 0;font-size:12.5px;color:#8a949c;text-align:center;">No newsletter, no spam — we'll only contact you about the pilot.</p>
            <p id="pilot-status" style="margin:16px 0 0;font-size:14px;text-align:center;display:none;"></p>
          </form>
        </div>
      </div>
    </section>

  </main>
  <Footer page="lightwell" />
</Base>

<script>
  // Lazy-load demo videos: play on enter (±200px), pause off-screen.
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        const v = en.target as HTMLVideoElement;
        if (en.isIntersecting) {
          if (v.preload === 'none') v.preload = 'auto';
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    },
    { rootMargin: '200px 0px' }
  );
  document.querySelectorAll<HTMLVideoElement>('video[data-lazyvid]').forEach((v) => obs.observe(v));

  // Pilot form submit → /api/contact (maps pilot fields to the worker's shape).
  const form = document.getElementById('pilot-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const status = document.getElementById('pilot-status')!;
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.style.color = ok ? '#1f9d55' : '#c81e2c';
      status.style.display = 'block';
    };
    const f = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const [first, ...rest] = (f.name || '').trim().split(/\s+/);
    const payload = {
      'company-website': f['company-website'],
      'first-name': first || f.name,
      'last-name': rest.join(' ') || '—',
      email: f.email,
      company: f.company,
      service: 'Lightwell pilot application',
      message:
        `Lightwell pilot application.\n` +
        `Machines: ${f.machines}\n` +
        `Makes: ${f.make}\n` +
        `Wants to track: ${f.track || '(not specified)'}`,
    };
    btn.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const out = await res.json();
      if (out.ok) {
        show("Thanks for your interest — we'll be in touch within one business day.", true);
        form.reset();
      } else {
        show(out.error || 'Could not send. Please email info@frontiermfg.ca directly.', false);
      }
    } catch {
      show('Could not send. Please email info@frontiermfg.ca directly.', false);
    }
    btn.disabled = false;
  });
</script>
