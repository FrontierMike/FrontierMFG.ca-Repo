---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, abs, serviceArea } from '../data/site';
import { ORG_ID, faqNode } from '../data/schema';

const videos = [
  { src: 'lightwell-demo-1', caption: 'DASHBOARD — LIVE VIEW' },
  { src: 'lightwell-demo-2', caption: 'SENSOR DETAIL' },
  { src: 'lightwell-demo-3', caption: 'TREND HISTORY' },
  { src: 'lightwell-demo-4', caption: 'ALERTS & STOPPAGES' },
];

const terms = [
  { n: 'Term 01', title: "What's a KPI?", copy: 'A "Key Performance Indicator" is simply a number that tells you whether things are going well — like parts per hour, scrap rate, or on-time shipments.', why: 'the right few numbers, tracked honestly, keep everyone pointed at the same goal.' },
  { n: 'Term 02', title: "What's OEE?", copy: '"Overall Equipment Effectiveness" rolls three things — how often a machine runs, how fast, and how many good parts it makes — into one honest score out of 100%.', why: 'most plants sit near 60%. Every point you recover is capacity you already paid for.' },
  { n: 'Term 03', title: "What's Industrial IoT?", copy: 'The "Industrial Internet of Things" just means factory equipment that\'s connected and can report on itself — sensors and machines sending data automatically instead of someone writing it on a clipboard.', why: 'automatic data is accurate data. No more guessing or manual logs that take up valuable time.' },
  { n: 'Term 04', title: "What's a live dashboard?", copy: 'Screens — on the floor, in the office, or on your phone — that show your KPIs updating in real time, instead of a report you get days later.', why: 'you can act on a problem while the shift is still running, not after it\'s over.' },
  { n: 'Term 05', title: 'Where does my data live?', copy: 'In the Lightwell database, running on a small computer we install in your shop — not in the cloud. The sensors write to it around the clock and the dashboard reads from it, all over your own network.', why: 'your production data never leaves the building, and there is nothing for you to administer.' },
  { n: 'Term 06', title: "What's standard vs. actual?", copy: 'The "standard" is the build time your costing and quotes assume — often set by one time study, years ago. The "actual" is how long the build really takes, measured every time it runs.', why: 'the gap between the two is where jobs quietly lose money, or get priced out.' },
  { n: 'Term 07', title: "What's lot traceability?", copy: 'Knowing which delivery a part came from, and which builds could contain it — so a bad batch points to a short list, not to everything you ever shipped.', why: 'recalls shrink, and supplier disputes get settled with dates instead of memories.' },
];

const modules = [
  {
    n: 'Module 01',
    title: 'Machine monitoring',
    lead: 'See how every machine is really running.',
    copy: 'Lightwell sensors track cycles, run time, stoppages and output automatically, around the clock — and the dashboard turns them into OEE, downtime and parts-per-hour you can act on during the shift.',
    points: ['Live OEE, output and downtime', 'Every stoppage logged automatically', 'Works on older and manual machines'],
  },
  {
    n: 'Module 02',
    title: 'Part tracking',
    lead: 'Know where every part is, which revision it is, and where it came from.',
    copy: "Find any part in seconds, see which revision is on the shelf and when the old one runs out, and trace a bad batch back to the delivery it arrived on. It works alongside your ERP — your ERP keeps the counts — and it changes nothing about how anyone builds.",
    points: ['Clean revision changeovers', 'Recalls narrowed to a short list', 'Supplier disputes settled with dates'],
  },
  {
    n: 'Module 03',
    title: 'Build cost',
    lead: 'Find out what each product really costs to build.',
    copy: "Labour is often the biggest cost a shop has never actually measured. Your standard times were probably set once, on one day. Lightwell measures every build since — a quick start and finish log at the job, no stopwatch and no clipboard — and shows the real spread against your standard, product by product.",
    points: ['Standard vs. actual, per product', 'Spot the products that cost more than you think', 'Quote from real numbers, not old estimates'],
  },
];

const fit = [
  { n: '01', title: 'Fits the systems you already run', copy: "Lightwell works alongside your ERP, your spreadsheets and your existing part numbers. We connect to what's there instead of asking you to replace it, and your ERP stays the system of record." },
  { n: '02', title: 'Fits the way your floor works', copy: 'Your products, your stations, your standards and your terms. We set Lightwell up around how your team already builds, not around a generic template.' },
  { n: '03', title: 'Grows at your pace', copy: 'Start with the module that solves your biggest problem. Add the next when you are ready, on the same database and the same dashboard.' },
];

const benefits = [
  { title: 'Find lost hours', copy: 'Downtime is the silent profit killer. When every stoppage is logged automatically, the real cost of small, "normal" interruptions finally becomes visible — and fixable.' },
  { title: 'Quote with confidence', copy: "When you know what each product really takes to build, quoting, scheduling, and hiring decisions stop resting on a hopeful estimate — and the jobs that quietly lose money show themselves." },
  { title: 'Change revisions cleanly', copy: 'Know which revision is on the shelf and when the old one runs out, so the changeover happens on purpose instead of by surprise.' },
  { title: 'Trace any delivery', copy: 'When a batch goes bad, see which builds it could have reached. A recall becomes a short list, and a supplier dispute becomes a date.' },
  { title: 'Prove improvements', copy: 'Change a process and see the impact on the same dashboard the next shift. No more debating whether something "felt" better.' },
  { title: 'Win more work', copy: 'Increasingly, larger customers want suppliers who can show real production data. Being able to is becoming a competitive edge.' },
];

const how = [
  { n: '01', title: 'Set up on your floor', copy: 'Small wireless Lightwell sensors attach to your machines and plug into standard wall power, and we set up part and build tracking around the way your team already works. No rewiring, no shutdown, no disruption to production.' },
  { n: '02', title: 'Collect on-site', copy: 'Machine cycles, stoppages and output, where parts are and where they came from, and how long each build takes — all landing in the Lightwell database on a small computer in your shop, with no clipboards.' },
  { n: '03', title: 'See it live', copy: 'The Lightwell dashboard tracks, displays, and compares it all — on the floor, in the office, or on your phone, updating in real time.' },
  { n: '04', title: 'Act & improve', copy: "With Frontier's help, turn what you learn into concrete changes — and watch the numbers move." },
];

const faqs = [
  { q: 'Will this work with my older machines?', a: 'Yes. The sensors mount to equipment you already own and measure what\'s happening from the outside — no PLC upgrade or special controller needed. Manual, semi-automatic, and CNC all work.' },
  { q: 'Do I need IT people or a network project?', a: 'No. The Lightwell sensors are wireless and run on standard wall power, and the Lightwell dashboard opens in any browser. The Lightwell database runs on a small computer we install and look after — nothing for you to maintain, and no IT project.' },
  { q: 'How disruptive is installation?', a: 'Minimal. We place the sensors during a normal visit — no production downtime and nothing cut into or wired through your machines.' },
  { q: 'What can it actually track?', a: 'Three things, as separate modules. Machine monitoring: output and part counts, run vs. idle time, downtime and stoppages, cycle time, and OEE. Part tracking: where each part is, which revision it is, and which delivery it came from. Build cost: how long each build really takes, against your standard.' },
  { q: 'Is Lightwell off-the-shelf software?', a: 'No. Lightwell is a build-to-suit system. We configure it around your products, your floor and the systems you already use, so it fits your shop instead of your shop bending to fit it.' },
  { q: 'Does this replace my ERP or inventory system?', a: 'No. Lightwell works alongside it. Your ERP stays the system of record for quantities and orders; Lightwell adds what it can\'t tell you — revisions, where parts are, which delivery they came from, and what each build really costs.' },
  { q: 'Will part tracking change how my team builds?', a: 'No. Part tracking changes nothing about how anyone builds. It adds a quick step when material arrives and when it goes on the shelf — that\'s all.' },
  { q: 'How do you measure real build time?', a: 'A quick start and finish log at the job — no stopwatch, no clipboard, and nobody standing over the bench. Every build is recorded, so you see the real spread for each product, not one number from one day.' },
  { q: 'Is my production data private?', a: "Yes — and it stays in your building. The Lightwell database runs on-site, not in the cloud, so your production data never leaves your own network. You control who on your team can see the dashboard." },
  { q: "What if I'm not technical?", a: "That's exactly who Lightwell is for. The Lightwell dashboard is plain-language and built to read at a glance — no data team and no training course required." },
  { q: 'When does Lightwell launch?', a: "General availability is targeted for the end of the year. Pilot partners are onboarded first — that's happening now." },
];

const pilotBenefits = [
  { n: '01', title: 'Hands-on setup, done for you', copy: 'Start with any module. We install the Lightwell sensors, set up the database on-site, and stand up your dashboard for you.' },
  { n: '02', title: 'Shape the product', copy: 'Your feedback directly guides what we build next.' },
  { n: '03', title: 'First in line at launch', copy: 'Pilot partners get priority when Lightwell becomes generally available.' },
];

const lightwellSchema = [
  faqNode(faqs),
  {
    '@type': 'Product',
    '@id': `${SITE_URL}/lightwell#product`,
    name: 'Lightwell Platform',
    description:
      'Wireless sensors, an on-site database, and a live dashboard that track machine OEE, output and downtime, part location, revision and lot traceability, and actual versus standard build cost — built to suit each shop and configured to work with its existing systems, with no cloud, no rewiring and no IT project.',
    category: 'Industrial IoT / manufacturing KPI monitoring, part traceability and build-cost tracking',
    brand: { '@id': ORG_ID },
    manufacturer: { '@id': ORG_ID },
    image: abs('/og-image.png'),
    audience: {
      '@type': 'BusinessAudience',
      name: 'Small and mid-size manufacturers',
      geographicArea: serviceArea.map((city) => ({ '@type': 'City', name: city })),
    },
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/PreOrder',
      areaServed: serviceArea.map((city) => ({ '@type': 'City', name: city })),
      seller: { '@id': ORG_ID },
    },
  },
];
---
<Base
  title="Lightwell — Machine, Part & Build-Cost Tracking for BC Manufacturers"
  description="Lightwell tracks machine OEE and downtime, part revisions and deliveries, and what each build really costs — on-site data, no cloud. Now piloting with Lower Mainland shops."
  breadcrumb={[['Lightwell', '/lightwell']]}
  schema={lightwellSchema}
>
  <Header page="lightwell" />
  <main>

    <!-- Hero -->
    <section style="background:var(--color-bg);color:var(--color-text);position:relative;overflow:hidden;">
      <div class="grid-dark-overlay"></div>
      <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,96px) 32px;position:relative;display:flex;flex-wrap:wrap;gap:56px;align-items:center;">
        <div style="flex:1 1 440px;min-width:300px;">
          <div style="display:inline-flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-accent-text);font-weight:500;margin-bottom:24px;background:rgba(179,38,30,0.12);border:1px solid rgba(179,38,30,0.35);padding:8px 15px;border-radius:100px;">
            <span class="pulse-dot" style="display:inline-block;width:7px;height:7px;border-radius:100px;background:var(--color-accent);"></span> Launching end of year — join the pilot
          </div>
          <h1 style="font-size:clamp(40px,5vw,66px);line-height:1.03;letter-spacing:-0.025em;font-weight:600;color:var(--color-text);margin:0 0 22px;text-wrap:balance;">The Lightwell Platform: Your machines, your parts, your real costs — made visible.</h1>
          <p style="font-size:19px;line-height:1.6;color:var(--color-body);margin:0 0 34px;max-width:540px;">Lightwell tracks how every machine is running, where every part is and where it came from, and what each build really costs — all in the Lightwell database, right there in your shop, where the Lightwell dashboard turns it into a live picture of your plant. Every install is built to suit: configured around your products, your floor and the systems you already run.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a href="#pilot" class="btn-red">Join the pilot <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
            <a href="#how" class="btn-ghost-dark">How it works</a>
          </div>
        </div>
        <!-- Build cost video -->
        <div style="flex:1 1 380px;min-width:300px;">
          <video src="/lightwell-build.mp4" poster="/lightwell-build-poster.jpg" width="1080" height="1080" autoplay loop muted playsinline aria-label="Lightwell build cost dashboard: live job timers, and weekly labour against standard falling from 22% over to 4% under across 12 weeks after a new fixture" style="display:block;width:100%;height:auto;border:1px solid rgba(255,255,255,0.08);border-radius:14px;box-shadow:0 30px 60px -24px rgba(0,0,0,0.55);background:#111217;"></video>
        </div>
      </div>
    </section>

    <!-- What is the Lightwell Platform + videos -->
    <section class="lines-white">
      <div style="max-width:900px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;text-align:center;">
        <div class="eyebrow" style="margin-bottom:18px;">What is the Lightwell Platform</div>
        <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0 0 22px;">Most shops fly blind. Lightwell turns the lights on.</h2>
        <p style="font-size:19px;line-height:1.65;color:var(--color-body);margin:0 auto;max-width:680px;">Ask most manufacturers how many good parts came off a line last Tuesday, or how much time was lost to stoppages, and the honest answer is a shrug or a stale spreadsheet. The Lightwell Platform is three parts working together: <strong>Lightwell sensors</strong> we place on your equipment, the <strong>Lightwell database</strong> they stream into on a small computer in your shop, and the <strong>Lightwell dashboard</strong> where it is all tracked, displayed and compared. Nothing goes to the cloud, and you open the dashboard on any screen — no rewiring, no IT project, no data team required.</p>
        <div style="display:flex;flex-direction:column;gap:0;margin-top:48px;text-align:left;border:1px solid var(--border);border-radius:16px;overflow:hidden;">
          {videos.map((v) => (
            <div style="background:var(--color-bg);position:relative;">
              <video src={`/${v.src}.mp4`} loop muted playsinline preload="none" data-lazyvid style="width:100%;height:auto;display:block;background:var(--color-panel-deep);"></video>
              <div style="position:absolute;left:14px;bottom:12px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.06em;color:var(--color-text);background:rgba(14,22,29,0.72);padding:5px 10px;border-radius:6px;">{v.caption}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Modules -->
    <section id="modules" class="lines-grey" style="border-top:1px solid var(--border);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:48px;">
          <div class="eyebrow" style="margin-bottom:18px;">What Lightwell tracks</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0 0 16px;">Three modules, one platform.</h2>
          <p style="font-size:22px;line-height:1.4;font-weight:600;color:var(--color-accent-text);margin:0 0 16px;">If you can't measure it, you can't manage it.</p>
          <p style="font-size:18px;line-height:1.6;color:var(--color-body);margin:0;">Machine time, material and labour are what a shop spends. Lightwell measures all three. Start with the one that hurts most. Each module runs on the same on-site database and shows up on the same dashboard, so adding the next one is a conversation, not a new system.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
          {modules.map((m) => (
            <div style="background:var(--color-surface);border:1px solid var(--border);border-radius:14px;padding:30px;display:flex;flex-direction:column;">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;">
                <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);">{m.n}</span>
                <span style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-muted);">In development · pilot</span>
              </div>
              <h3 style="font-size:23px;font-weight:600;color:var(--color-text);margin:0 0 8px;letter-spacing:-0.01em;">{m.title}</h3>
              <p style="font-size:16px;line-height:1.5;color:var(--color-text);margin:0 0 12px;">{m.lead}</p>
              <p style="font-size:15px;line-height:1.65;color:var(--color-body);margin:0 0 18px;">{m.copy}</p>
              <div style="display:flex;flex-direction:column;gap:8px;margin-top:auto;">
                {m.points.map((p) => (
                  <div style="display:flex;gap:10px;font-size:14.5px;color:var(--color-body);"><span style="color:var(--color-accent-text);font-family:'IBM Plex Mono',monospace;">→</span>{p}</div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Built to suit -->
    <section class="lines-white" style="border-top:1px solid var(--border);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:720px;margin-bottom:48px;">
          <div class="eyebrow" style="margin-bottom:18px;">Built to suit</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0 0 16px;">Not off the shelf. Built around your shop.</h2>
          <p style="font-size:18px;line-height:1.6;color:var(--color-body);margin:0;">Every shop runs differently, so Lightwell isn't a one-size-fits-all product. Each install is customized to work with your current systems and the way your team already works.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px;">
          {fit.map((f) => (
            <div>
              <div style="width:56px;height:56px;border:1.5px solid var(--color-accent);border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:18px;color:var(--color-accent-text);margin-bottom:20px;">{f.n}</div>
              <h3 style="font-size:19px;font-weight:600;color:var(--color-text);margin:0 0 10px;">{f.title}</h3>
              <p style="font-size:15px;line-height:1.6;color:var(--color-body);margin:0;">{f.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- New to this? Start here -->
    <section id="learn" class="lines-grey" style="border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:48px;">
          <div class="eyebrow" style="margin-bottom:18px;">New to this? Start here</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0 0 16px;">The jargon, in plain English.</h2>
          <p style="font-size:18px;line-height:1.6;color:var(--color-body);margin:0;">You don't need to be technical to benefit from any of this. Here's what the terms actually mean — and why each one matters for your bottom line.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
          {terms.map((t) => (
            <div style="background:var(--color-surface);border:1px solid var(--border);border-radius:14px;padding:30px;">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);margin-bottom:14px;">{t.n}</div>
              <h3 style="font-size:21px;font-weight:600;color:var(--color-text);margin:0 0 12px;letter-spacing:-0.01em;">{t.title}</h3>
              <p style="font-size:15px;line-height:1.65;color:var(--color-body);margin:0 0 14px;">{t.copy}</p>
              <p style="font-size:14px;line-height:1.6;color:var(--color-muted);margin:0;"><span style="color:var(--color-text);font-weight:600;">Why it matters:</span> {t.why}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="lines-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:52px;">
          <div class="eyebrow" style="margin-bottom:18px;">Why it matters</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0;">What clear data actually changes.</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:40px 48px;">
          {benefits.map((b) => (
            <div>
              <div style="font-size:34px;font-weight:600;color:var(--color-accent-text);letter-spacing:-0.02em;margin-bottom:10px;">{b.title}</div>
              <p style="font-size:15.5px;line-height:1.65;color:var(--color-body);margin:0;">{b.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="lines-grey" style="border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:52px;">
          <div class="eyebrow" style="margin-bottom:18px;">How the Lightwell Platform works</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0;">Up and running, without the IT project.</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:32px;">
          {how.map((h) => (
            <div>
              <div style="width:56px;height:56px;border:1.5px solid var(--color-accent);border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:18px;color:var(--color-accent-text);margin-bottom:22px;">{h.n}</div>
              <h3 style="font-size:19px;font-weight:600;color:var(--color-text);margin:0 0 10px;">{h.title}</h3>
              <p style="font-size:15px;line-height:1.6;color:var(--color-body);margin:0;">{h.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- And then... AI -->
    <section style="background:var(--color-bg);color:var(--color-text);">
      <div style="max-width:900px;margin:0 auto;padding:clamp(56px,7vw,88px) 32px;text-align:center;">
        <div class="eyebrow" style="margin-bottom:18px;">And then... AI</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);line-height:1.12;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0 0 20px;">The Lightwell Platform is your on-ramp to AI.</h2>
        <p style="font-size:18px;line-height:1.65;color:var(--color-body);margin:0 auto;max-width:640px;">The reason AI feels out of reach for most shops is simple: AI needs data, and most shops don't have any. Once Lightwell is capturing clean, consistent production data, the door opens to genuinely useful AI — predicting maintenance before a breakdown, forecasting output, and spotting patterns no person would catch. Get the data right first, and AI stops being a buzzword and starts being an advantage.</p>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="lines-grey" style="border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
      <div style="max-width:1000px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        <div style="max-width:680px;margin-bottom:48px;">
          <div class="tick" style="margin-bottom:16px;"></div>
          <div class="eyebrow" style="margin-bottom:18px;">Common questions</div>
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0;">The questions shops actually ask.</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
          {faqs.map((f) => (
            <div style="background:var(--color-surface);border:1px solid var(--border);border-radius:14px;padding:26px;">
              <h3 style="font-size:17px;font-weight:600;color:var(--color-text);margin:0 0 10px;">{f.q}</h3>
              <p style="font-size:15px;line-height:1.6;color:var(--color-body);margin:0;">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pilot -->
    <section id="pilot" style="background:var(--color-surface);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;display:flex;flex-wrap:wrap;gap:56px;">
        <div style="flex:1 1 380px;min-width:300px;">
          <div style="display:inline-flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-accent-text);font-weight:500;margin-bottom:22px;background:var(--accent-tint);border:1px solid rgba(179,38,30,0.25);padding:7px 14px;border-radius:100px;">Limited pilot — a handful of BC shops</div>
          <h2 style="font-size:clamp(30px,3.6vw,48px);line-height:1.06;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0 0 20px;">Be one of the first to run on Lightwell.</h2>
          <p style="font-size:18px;line-height:1.65;color:var(--color-body);margin:0 0 32px;max-width:480px;">We're partnering with a small group of Lower Mainland manufacturers to prove Lightwell on real shop floors. Pilot partners get early access, hands-on setup, and a direct say in where the product goes.</p>
          <div style="display:flex;flex-direction:column;gap:16px;">
            {pilotBenefits.map((p) => (
              <div style="display:flex;gap:14px;align-items:flex-start;"><span style="color:var(--color-accent-text);font-family:'IBM Plex Mono',monospace;margin-top:2px;">{p.n}</span><div><div style="font-size:16px;font-weight:600;color:var(--color-text);margin-bottom:3px;">{p.title}</div><div style="font-size:14.5px;line-height:1.6;color:var(--color-body);">{p.copy}</div></div></div>
            ))}
          </div>
          <div style="margin-top:40px;">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-muted);margin-bottom:14px;">Who's behind the Lightwell Platform</div>
            <div style="display:flex;flex-wrap:wrap;gap:12px 28px;">
              <a href="/#about" style="display:flex;align-items:center;gap:12px;color:var(--color-text);">
                <span style="width:46px;height:46px;border-radius:11px;background:var(--color-surface);display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:15px;color:var(--color-text);position:relative;flex-shrink:0;">MW<span style="position:absolute;top:6px;right:6px;width:5px;height:5px;background:var(--color-accent);border-radius:1px;transform:rotate(45deg);"></span></span>
                <span><span style="display:block;font-size:15px;font-weight:600;">Mike Wait</span><span style="display:block;font-size:12.5px;color:var(--color-body);">Founder — leads Lightwell</span></span>
              </a>
              <a href="/#about" style="display:flex;align-items:center;gap:12px;color:var(--color-text);">
                <span style="width:46px;height:46px;border-radius:11px;background:var(--color-surface);display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:15px;color:var(--color-text);position:relative;flex-shrink:0;">GW<span style="position:absolute;top:6px;right:6px;width:5px;height:5px;background:var(--color-accent);border-radius:1px;transform:rotate(45deg);"></span></span>
                <span><span style="display:block;font-size:15px;font-weight:600;">Gord Wait</span><span style="display:block;font-size:12.5px;color:var(--color-body);">Product-design advisor</span></span>
              </a>
            </div>
          </div>
        </div>
        <div style="flex:1 1 420px;min-width:300px;">
          <form id="pilot-form" style="background:var(--color-bg-alt);border:1px solid var(--border);border-radius:16px;padding:30px;">
            <h3 style="font-size:20px;font-weight:600;color:var(--color-text);margin:0 0 6px;">Apply to join the pilot</h3>
            <p style="font-size:14px;color:var(--color-body);margin:0 0 22px;">Takes two minutes. We'll follow up within one business day.</p>
            <input type="text" name="company-website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;" />
            <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:14px;">
              <div style="flex:1 1 140px;">
                <label for="pf-name" class="form-label form-label-light">Name</label>
                <input id="pf-name" name="name" type="text" required class="input-light" />
              </div>
              <div style="flex:1 1 140px;">
                <label for="pf-company" class="form-label form-label-light">Company</label>
                <input id="pf-company" name="company" type="text" required class="input-light" />
              </div>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:14px;">
              <div style="flex:1 1 140px;">
                <label for="pf-email" class="form-label form-label-light">Email</label>
                <input id="pf-email" name="email" type="email" required class="input-light" />
              </div>
              <div style="flex:1 1 140px;">
                <label for="pf-machines" class="form-label form-label-light"># of machines</label>
                <select id="pf-machines" name="machines" class="input-light">
                  <option>1 – 5</option>
                  <option>6 – 15</option>
                  <option>16 – 40</option>
                  <option>40+</option>
                </select>
              </div>
            </div>
            <div style="margin-bottom:14px;">
              <label for="pf-make" class="form-label form-label-light">What do you make?</label>
              <input id="pf-make" name="make" type="text" required class="input-light" />
            </div>
            <div style="margin-bottom:20px;">
              <label for="pf-track" class="form-label form-label-light">What would you most want to track? (optional)</label>
              <textarea id="pf-track" name="track" rows="3" class="input-light" style="resize:vertical;"></textarea>
            </div>
            <button type="submit" class="btn-red" style="width:100%;">Apply to join the pilot</button>
            <p style="margin:12px 0 0;font-size:12.5px;color:var(--color-muted);text-align:center;">No newsletter, no spam — we'll only contact you about the pilot.</p>
            <p id="pilot-status" style="margin:16px 0 0;font-size:14px;text-align:center;display:none;"></p>
          </form>
        </div>
      </div>
    </section>

  </main>
  <Footer page="lightwell" />
</Base>

<script>
  // Lazy-load demo videos: play on enter (±200px), pause off-screen.
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        const v = en.target as HTMLVideoElement;
        if (en.isIntersecting) {
          if (v.preload === 'none') v.preload = 'auto';
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    },
    { rootMargin: '200px 0px' }
  );
  document.querySelectorAll<HTMLVideoElement>('video[data-lazyvid]').forEach((v) => obs.observe(v));

  // Pilot form submit → /api/contact (maps pilot fields to the worker's shape).
  const form = document.getElementById('pilot-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const status = document.getElementById('pilot-status')!;
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.style.color = ok ? 'var(--color-ok)' : 'var(--color-bad)';
      status.style.display = 'block';
    };
    const f = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const [first, ...rest] = (f.name || '').trim().split(/\s+/);
    const payload = {
      'company-website': f['company-website'],
      'first-name': first || f.name,
      'last-name': rest.join(' ') || '—',
      email: f.email,
      company: f.company,
      service: 'Lightwell pilot application',
      message:
        `Lightwell pilot application.\n` +
        `Machines: ${f.machines}\n` +
        `Makes: ${f.make}\n` +
        `Wants to track: ${f.track || '(not specified)'}`,
    };
    btn.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const out = await res.json();
      if (out.ok) {
        show("Thanks for your interest — we'll be in touch within one business day.", true);
        form.reset();
      } else {
        show(out.error || 'Could not send. Please email info@frontiermfg.ca directly.', false);
      }
    } catch {
      show('Could not send. Please email info@frontiermfg.ca directly.', false);
    }
    btn.disabled = false;
  });
</script>
