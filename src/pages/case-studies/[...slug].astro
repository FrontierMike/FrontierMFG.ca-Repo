---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookCta from '../../components/BookCta.astro';
import DimensionLine from '../../components/DimensionLine.astro';
import { getCaseStudies } from '../../data/content';

export const getStaticPaths = (async () =>
  (await getCaseStudies()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, industry, draft } = entry.data;
---
<Base
  title={`${title} — Case Study — Frontier MFG`}
  description={description}
  breadcrumb={[['Case Studies', '/case-studies'], [title, `/case-studies/${entry.id}`]]}
  noindex={draft}
>
  <Header />
  <main>
    <article>
      <header class="band-dark blueprint" style="border-bottom:1px solid var(--line);">
        <div class="wrap" style="max-width:880px;padding-block:clamp(56px,7vw,96px);">
          <a href="/case-studies" class="nav-link" style="display:inline-flex;align-items:center;gap:8px;font-size:14px;margin-bottom:26px;"><ArrowLeft size={16} stroke-width={1.75} aria-hidden="true" /> Case studies</a>
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;margin-bottom:20px;">
            <span class="label">{industry ?? 'Case study'}</span>
            {draft && <span class="pill">Draft · not published</span>}
          </div>
          <h1 class="display h1" style="font-size:clamp(2.5rem,1.7rem+3.4vw,4rem);">{title}</h1>
          <DimensionLine class="mt-6" />
          <p class="lead" style="margin-top:24px;">{description}</p>
        </div>
      </header>

      <div class="band-light">
        <div class="wrap prose-article" style="max-width:880px;padding-block:clamp(56px,7vw,96px);">
          <Content />
        </div>
      </div>
    </article>

    <BookCta title="Want numbers like these for your shop?" />
  </main>
  <Footer />
</Base>
