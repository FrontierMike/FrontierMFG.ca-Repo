---
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import BookCta from '../../components/BookCta.astro';
import { getCaseStudies } from '../../data/content';

// While there are no published case studies this page is noindex, and it is
// left out of the nav and the sitemap. All three switch on with the first one.
const caseStudies = await getCaseStudies();
const empty = caseStudies.length === 0;
---
<Base
  title="Case Studies — Frontier MFG"
  description="Automation projects for BC manufacturers, measured before and after against the same baseline."
  breadcrumb={[['Case Studies', '/case-studies']]}
  noindex={empty}
>
  <Header />
  <main>

    <PageHero
      eyebrow="Case studies"
      title="Automation backed by your own numbers."
      lead="Each project is measured before and after against the same baseline."
    />

    <section class="band-light blueprint section">
      <div class="wrap">
        {empty ? (
          <p style="font-size:17px;line-height:1.6;margin:0;">No case studies published yet.</p>
        ) : (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {caseStudies.map((c, i) => (
              <a href={`/case-studies/${c.id}`} class="card card-link" data-reveal style={`--reveal-delay:${i * 70}ms;padding:28px;color:var(--text);`}>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                  {c.data.industry && <span class="label">{c.data.industry}</span>}
                  {c.data.draft && <span class="pill">Draft</span>}
                </div>
                <h2 class="h3">{c.data.title}</h2>
                <p style="font-size:15px;line-height:1.6;color:var(--text-body);margin:10px 0 22px;">{c.data.description}</p>
                <span style="margin-top:auto;display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px;">Read the case study <ArrowRight class="arrow" size={18} stroke-width={1.75} aria-hidden="true" /></span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <BookCta />

  </main>
  <Footer />
</Base>
