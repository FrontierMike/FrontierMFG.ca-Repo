---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import BookCta from '../../components/BookCta.astro';
import { getCaseStudies } from '../../data/content';

// While there are no published case studies this page is noindex, and it is
// left out of the nav and the sitemap. All three switch on with the first one.
const caseStudies = await getCaseStudies();
const empty = caseStudies.length === 0;
---
<Base
  title="Case Studies — Frontier MFG"
  description="Automation projects for BC manufacturers, measured before and after against the same baseline."
  breadcrumb={[['Case Studies', '/case-studies']]}
  noindex={empty}
>
  <Header />
  <main>

    <PageHero
      eyebrow="Case studies"
      title="Automation backed by your own numbers."
      lead="Each project is measured before and after against the same baseline."
    />

    <section class="dots-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;">
        {empty ? (
          <p style="font-size:17px;line-height:1.6;color:var(--color-body);margin:0;">No case studies published yet.</p>
        ) : (
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:24px;">
            {caseStudies.map((c) => (
              <a href={`/case-studies/${c.id}`} class="card-hover" style="display:flex;flex-direction:column;border:1px solid var(--border);border-radius:14px;padding:28px;background:var(--color-bg-alt);color:var(--color-text);">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                  {c.data.industry && <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);">{c.data.industry}</span>}
                  {c.data.draft && <span class="pill-soon">DRAFT</span>}
                </div>
                <h2 style="font-size:20px;line-height:1.3;font-weight:600;margin:0 0 10px;">{c.data.title}</h2>
                <p style="font-size:15px;line-height:1.6;color:var(--color-body);margin:0 0 18px;">{c.data.description}</p>
                <span style="margin-top:auto;color:var(--color-accent-text);font-size:15px;font-weight:500;">Read the case study →</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <BookCta />

  </main>
  <Footer />
</Base>
