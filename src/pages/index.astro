---
import { ArrowRight, Eye, Ruler, Cog, Lock, Calculator } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import BookCta from '../components/BookCta.astro';
import DimensionLine from '../components/DimensionLine.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import ExampleChart from '../components/ExampleChart.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { services } from '../data/site';
import { getCaseStudies } from '../data/content';

const method = [
  { name: 'See', icon: Eye, href: '/how-it-works#see', copy: 'We walk your floor, talk to your operators, and pull the records you already keep.' },
  { name: 'Measure', icon: Ruler, href: '/how-it-works#measure', copy: 'We turn what we find into a baseline of where your hours and output go, in dollars.' },
  { name: 'Automate', icon: Cog, href: '/how-it-works#automate', copy: 'We fix what pays back fastest, then measure again against the same baseline.' },
];

const assessmentIn = ['Floor walk', 'Operator interviews', 'Your records: production counts, downtime, scrap, overtime'];
const assessmentOut = ['A baseline in hours and dollars', 'Fixes ranked by payback', 'A savings and payback estimate'];

// Proof section. Stays hidden until the first case study is published in
// src/content/case-studies; it then appears with no code change.
const caseStudies = (await getCaseStudies()).slice(0, 3);
---
<Base
  title="Practical Automation for BC Manufacturers — Frontier MFG"
  description="Practical automation and robotics for BC manufacturers. We measure where time and output go, then automate what pays back fastest."
>
  <Header />
  <main>

    <!-- Hero. TODO: photo — hero background (a real shop-floor photo under a
         dark overlay) once Mike supplies one; the blueprint grid stands in. -->
    <section class="band-dark blueprint" style="border-bottom:1px solid var(--line);">
      <div class="wrap grid items-center gap-14 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]" style="padding-block:clamp(64px,9vw,128px);">
        <div>
          <div class="label" style="margin-bottom:22px;">Automation &amp; systems integration</div>
          <h1 class="display h1">Practical automation for BC manufacturers.</h1>
          <DimensionLine class="mt-6" label="Measured, not guessed" />
          <p class="lead" style="margin:26px 0 34px;max-width:540px;">Modernize your shop and increase productivity, starting with measured data, not guesses.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a href="/contact" class="btn btn-primary">Book a Productivity Assessment <ArrowRight class="arrow" size={18} stroke-width={2} aria-hidden="true" /></a>
            <a href="/how-it-works" class="btn btn-secondary">See how it works</a>
          </div>
          <p style="margin:16px 0 0;font-size:14.5px;color:var(--text-muted);">A short on-site audit that ends with a savings and payback estimate.</p>
          <div class="mono" style="display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;margin-top:36px;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-body);">
            <span class="label">Based in Surrey, BC</span>
            <span aria-hidden="true" style="color:var(--text-muted);">/</span>
            <span>B.Eng, EIT</span>
            <span aria-hidden="true" style="color:var(--text-muted);">/</span>
            <span>In the trades since 2011</span>
          </div>
        </div>

        <!-- What an assessment takes in, and what it gives back -->
        <div class="card" style="padding:clamp(22px,3vw,30px);">
          <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px 12px;margin-bottom:22px;">
            <span class="label-muted" style="color:var(--text);">Productivity Assessment</span>
            <span class="label" style="white-space:nowrap;">On-site</span>
          </div>
          <div class="label-muted" style="margin-bottom:12px;">What we look at</div>
          <ul style="list-style:none;margin:0 0 22px;padding:0;display:flex;flex-direction:column;gap:10px;">
            {assessmentIn.map((t) => (
              <li style="border:1px solid var(--line);border-radius:4px;padding:11px 14px;font-size:15px;line-height:1.45;color:var(--text-body);">{t}</li>
            ))}
          </ul>
          <DimensionLine label="Gives you" class="mb-5" />
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;">
            {assessmentOut.map((t) => (
              <li style="display:flex;gap:12px;align-items:baseline;background:var(--color-ink);border-left:3px solid var(--color-safety);border-radius:2px;padding:11px 14px;font-size:15px;line-height:1.45;color:var(--text);">{t}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Method -->
    <section id="method" class="band-light section">
      <div class="wrap">
        <SectionHead eyebrow="Our method" title="See it, measure it, automate it." lead="A lot of automation starts with a machine. Ours starts with your numbers, so you know what a project is worth before you spend on it." />
        <ProcessDiagram steps={method} />

        <div class="grid items-center gap-10 lg:grid-cols-2" style="margin-top:clamp(64px,8vw,96px);">
          <div data-reveal>
            <div class="label" style="margin-bottom:14px;">02 / Measure</div>
            <h3 class="h3" style="font-size:clamp(28px,3vw,36px);text-transform:uppercase;font-weight:700;">What a baseline looks like</h3>
            <p style="margin:16px 0 0;font-size:17px;line-height:1.65;">A baseline shows where a machine's week actually goes: running, setting up, or waiting. Once it's measured, you can see which fix buys back the most hours, and check the result afterwards against the same numbers.</p>
            <p style="display:flex;align-items:center;gap:10px;margin:20px 0 0;color:var(--text);font-weight:600;"><Lock size={18} stroke-width={1.75} aria-hidden="true" style="color:var(--accent-text);" /> Your data stays yours.</p>
            <a href="/how-it-works" class="link" style="display:inline-block;margin-top:24px;">How it works, step by step</a>
          </div>
          <div data-reveal style="--reveal-delay:120ms;">
            <ExampleChart />
          </div>
        </div>
      </div>
    </section>

    <!-- What we automate -->
    <section id="services" class="band-dark blueprint section" style="border-top:1px solid var(--line);">
      <div class="wrap">
        <div style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:flex-end;margin-bottom:48px;">
          <SectionHead eyebrow="Services" title="What we automate." lead="Every project starts with an assessment, so the fix fits the problem." maxWidth={640} gap={0} />
          <a href="/services" class="link" style="white-space:nowrap;">All services in detail</a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {services.map((s, i) => (
            <a href={`/services#${s.id}`} class="card card-link" data-reveal style={`--reveal-delay:${i * 80}ms;padding:28px;color:var(--text);`}>
              <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px;">
                <span class="icon-tile"><ServiceIcon id={s.id} /></span>
                {'inDevelopment' in s && <span class="pill">In development</span>}
              </div>
              <h3 class="h3">{s.title}</h3>
              <p style="margin:10px 0 22px;font-size:15px;line-height:1.6;color:var(--text-body);">{s.summary}</p>
              <ArrowRight class="arrow" size={20} stroke-width={1.75} aria-hidden="true" style="margin-top:auto;" />
            </a>
          ))}
        </div>
      </div>
    </section>

    {caseStudies.length > 0 && (
      <!-- Proof: case studies -->
      <section id="proof" class="band-light section">
        <div class="wrap">
          <SectionHead eyebrow="Case studies" title="Automation backed by your own numbers." lead="Each project is measured before and after against the same baseline." />
          <div class="grid gap-6 md:grid-cols-3">
            {caseStudies.map((c, i) => (
              <a href={`/case-studies/${c.id}`} class="card card-link" data-reveal style={`--reveal-delay:${i * 80}ms;padding:28px;color:var(--text);`}>
                {c.data.industry && <div class="label" style="margin-bottom:14px;">{c.data.industry}</div>}
                <h3 class="h3">{c.data.title}</h3>
                <p style="margin:10px 0 22px;font-size:15px;line-height:1.6;color:var(--text-body);">{c.data.description}</p>
                <span style="margin-top:auto;display:inline-flex;align-items:center;gap:8px;font-weight:600;">Read the case study <ArrowRight class="arrow" size={18} stroke-width={1.75} aria-hidden="true" /></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Payback calculator teaser. Flips to dark when the proof section above
         is showing, so the bands keep alternating. -->
    <section class:list={[caseStudies.length > 0 ? 'band-dark' : 'band-light', 'section']}>
      <div class="wrap grid items-center gap-12 lg:grid-cols-2">
        <div>
          <SectionHead eyebrow="Payback calculator" title="Run the payback math yourself." lead="Enter the labour hours, scrap, and downtime a project would save, and what it would cost. You'll get a rough payback period in a minute. Nothing you type leaves your browser." gap={32} />
          <a href="/payback-calculator" class="btn btn-secondary">Open the payback calculator <ArrowRight class="arrow" size={18} stroke-width={2} aria-hidden="true" /></a>
        </div>
        <div class="card" data-reveal style="--reveal-delay:120ms;padding:clamp(24px,3vw,32px);">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
            <span class="icon-tile"><Calculator size={22} stroke-width={1.6} aria-hidden="true" /></span>
            <span class="label-muted">The basic formula</span>
          </div>
          <div class="mono" style="font-size:clamp(17px,2vw,20px);line-height:1.5;font-weight:500;color:var(--text);">Payback (months) =<br />project cost ÷ monthly savings</div>
          <DimensionLine class="my-5" />
          <p style="font-size:15px;line-height:1.6;margin:0;">Savings come from labour, scrap, and downtime. Downtime only counts on the machine that limits your output.</p>
        </div>
      </div>
    </section>

    <!-- id="contact" keeps old /#contact links landing on a booking prompt. -->
    <BookCta id="contact" />

  </main>
  <Footer />
</Base>
