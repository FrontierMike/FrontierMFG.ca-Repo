---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
  'Process Automation', 'PLC / SCADA Programming', 'Controls Design', 'Real-Time KPI Tracking',
  'Industrial IoT', 'Feasibility Studies', 'Design for Manufacturing', 'Process Improvement',
];

const why = [
  { n: '01', title: "See what's really happening", copy: 'Real-time visibility into output, downtime, and bottlenecks — instead of guesswork and month-end spreadsheets that are already out of date.' },
  { n: '02', title: 'Catch problems early', copy: "Live KPIs flag issues the moment they happen, so a small hiccup on the line doesn't quietly turn into an expensive shutdown." },
  { n: '03', title: 'Decide with data', copy: 'Replace gut-feel and hallway anecdotes with hard numbers your whole team can see and trust — from the floor to the front office.' },
  { n: '04', title: 'Get ready for AI', copy: "Clean, consistent data is the foundation. Once it's flowing, forecasting and AI-driven optimization stop being hype and start being useful." },
];

const services = [
  { n: '01', icon: '01-process-automation', title: 'Process Automation', copy: 'Identify automation opportunities and implement solutions that reduce manual labour and increase throughput.' },
  { n: '02', icon: '02-plc-scada-programming', title: 'PLC / SCADA Programming', copy: 'Custom logic, HMI design, and commissioning support for Allen-Bradley, Siemens, and more.' },
  { n: '03', icon: '03-hardware-software-integration', title: 'Hardware & Software Integration', copy: 'Bridging industrial hardware and software — sensors, controllers, networks, and custom software.' },
  { n: '04', icon: '04-process-improvement', title: 'Process Improvement', copy: 'Lean-informed analysis of production workflows to eliminate bottlenecks and reduce waste.' },
  { n: '05', icon: '05-feasibility-studies', title: 'Feasibility Studies', copy: 'Technical and economic assessments to validate automation investments before you commit.' },
  { n: '06', icon: '06-design-for-manufacturing', title: 'Design for Manufacturing', copy: 'DFM reviews that bridge design intent with production reality — reducing rework and material waste.' },
  { n: '07', icon: '07-machining-consultation', title: 'Machining Consultation', copy: 'Process parameters, toolpath strategy, and fixturing advice for CNC machining operations.' },
  { n: '08', icon: '08-Controls-pulse-waveform', title: 'Controls Design', copy: 'Panel layouts, I/O schematics, and control architecture — designed for reliability and easy maintenance.' },
];

const steps = [
  { n: '01', title: 'Free discovery call', copy: 'A free 30-minute call to understand your operation, constraints, and goals. No commitment required.' },
  { n: '02', title: 'Site assessment', copy: 'Where needed, we visit your facility to observe processes, audit equipment, and gather technical data.' },
  { n: '03', title: 'Proposal & scope', copy: 'A clear written proposal with defined deliverables, timeline, and fixed or hourly pricing — no surprises.' },
  { n: '04', title: 'Delivery', copy: 'We execute the work, keep you informed throughout, and provide handover documentation at completion.' },
];

const bars = [62, 70, 58, 67, 61, 64, 69, 57, 66, 71, 60, 63, 59, 66];

const sensors = [
  { id: 'S-01 PRESS', pct: 98, dot: '#64b450' },
  { id: 'S-02 CNC', pct: 76, dot: '#64b450' },
  { id: 'S-03 WELD', pct: 61, dot: '#c88c28' },
  { id: 'S-04 PACK', pct: 89, dot: '#64b450' },
];
---
<Base
  title="Frontier MFG — Automation & manufacturing consulting"
  description="Frontier MFG helps small and mid-size manufacturers modernize — automation, controls, and real-time KPI tracking. Practical upgrades, measurable results, no jargon."
>
  <Header page="home" />
  <main>

    <!-- Hero -->
    <section class="dots-hero" style="border-bottom:1px solid #e6e9ec;">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,96px) 32px;display:flex;flex-wrap:wrap;gap:56px;align-items:center;">
        <div style="flex:1 1 440px;min-width:300px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <span style="display:block;width:32px;height:2px;background:#b3261e;"></span>
            <span class="eyebrow">Automation &amp; Manufacturing Consulting</span>
          </div>
          <h1 style="font-size:clamp(40px,5.2vw,68px);line-height:1.03;letter-spacing:-0.025em;font-weight:600;color:#16202a;margin:0 0 22px;text-wrap:balance;">Bring your shop floor into the age of data.</h1>
          <p style="font-size:18px;line-height:1.6;color:#566169;margin:0 0 32px;max-width:520px;">Frontier MFG helps small and mid-size manufacturers modernize — from automation and controls to real-time KPI tracking. Practical upgrades, measurable results, and no jargon.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:36px;">
            <a href="#contact" class="btn-red">Book a free consultation <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
            <a href="#modernize" class="btn-outline">See how it works</a>
          </div>
          <div style="font-size:13.5px;color:#8a949c;margin:-22px 0 36px;">Free 30 minutes · no commitment — and if you don't need us, we'll say so.</div>
          <div style="display:flex;flex-wrap:wrap;gap:10px 22px;align-items:center;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.03em;color:#566169;">
            <span>20+ yrs in manufacturing</span>
            <span style="color:#cbd2d8;">/</span>
            <span>B.Eng, EIT</span>
            <span style="color:#cbd2d8;">/</span>
            <span style="display:inline-flex;align-items:center;gap:7px;"><img src="/icons/maple-leaf-from-the-flag-of-Canada.svg" width="14" height="14" alt="Canada" /> Lower Mainland, BC</span>
          </div>
        </div>

        <!-- Dashboard mockup -->
        <div style="flex:1 1 420px;min-width:300px;">
          <div style="background:#0a0e13;border:1px solid rgba(255,255,255,0.08);border-radius:14px;box-shadow:0 30px 60px -24px rgba(19,28,36,0.5);padding:14px;display:flex;flex-direction:column;gap:10px;">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0 2px 2px;">
              <div style="display:flex;align-items:center;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.06em;color:#c3cad2;">
                <span class="pulse-dot" style="display:inline-block;width:7px;height:7px;border-radius:100px;background:#73bf69;"></span>
                LIGHTWELL · CNC-01
              </div>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#6b7079;">LIVE · 14 D</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
              <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:12px;">
                <div style="font-size:10px;color:#8b929b;margin-bottom:8px;">OEE (14 d)</div>
                <div style="font-size:27px;font-weight:400;color:#73bf69;letter-spacing:-0.01em;line-height:1;">82<span style="font-size:14px;color:#8b929b;"> %</span></div>
              </div>
              <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:12px;">
                <div style="font-size:10px;color:#8b929b;margin-bottom:8px;">MTBF (14 d)</div>
                <div style="font-size:27px;font-weight:400;color:#d9a520;letter-spacing:-0.01em;line-height:1;">20.5<span style="font-size:14px;color:#8b929b;"> h</span></div>
              </div>
              <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:12px;">
                <div style="font-size:10px;color:#8b929b;margin-bottom:8px;">Downtime</div>
                <div style="font-size:27px;font-weight:400;color:#f2495c;letter-spacing:-0.01em;line-height:1;">7.9<span style="font-size:14px;color:#8b929b;"> h</span></div>
              </div>
            </div>
            <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:12px;">
              <div style="font-size:10px;color:#8b929b;margin-bottom:12px;">▾ OUTPUT &amp; TREND — OEE DAILY %</div>
              <div style="display:flex;gap:7px;">
                <div style="display:flex;flex-direction:column;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:8px;color:#5f656e;height:82px;padding-bottom:14px;"><span>60</span><span>40</span><span>20</span><span>0</span></div>
                <div style="flex:1;">
                  <div style="display:flex;align-items:flex-end;gap:3px;height:82px;border-left:1px solid rgba(255,255,255,0.07);border-bottom:1px solid rgba(255,255,255,0.09);padding-left:6px;">
                    {bars.map((h) => <div style={`flex:1;height:${h}%;background:#d9a520;border-top:2px solid #b7861a;`}></div>)}
                  </div>
                  <div style="display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:8px;color:#5f656e;margin-top:5px;padding-left:6px;"><span>06/24</span><span>06/30</span><span>07/07</span></div>
                </div>
              </div>
            </div>
            <div style="background:#0e141b;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:12px;">
              <div style="font-size:10px;color:#8b929b;margin-bottom:10px;">MACHINE STATE — LAST 24 H</div>
              <div style="height:28px;border-radius:3px;background-image:repeating-linear-gradient(90deg,transparent 0,transparent 74px,#f2495c 74px,#f2495c 80px,transparent 80px,transparent 166px),repeating-linear-gradient(90deg,#73bf69 0,#73bf69 5px,#0e141b 5px,#0e141b 7px);"></div>
              <div style="display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:8px;color:#5f656e;margin-top:6px;"><span>23:00</span><span>05:00</span><span>11:00</span><span>17:00</span><span>22:00</span></div>
            </div>
          </div>
          <div style="text-align:center;margin-top:12px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.08em;color:#9aa4ad;">LIGHTWELL DASHBOARD — PRODUCT PREVIEW</div>
        </div>
      </div>
    </section>

    <!-- Capabilities marquee -->
    <div class="marquee-wrap" style="background:#131c24;overflow:hidden;border-bottom:1px solid rgba(255,255,255,0.06);">
      <div class="marquee-track">
        {[false, true].map((dup) => (
          <div aria-hidden={dup || undefined} style="display:flex;align-items:center;gap:0;padding:16px 0;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#9aa4ad;">
            {capabilities.map((c) => <><span style="padding:0 26px;">{c}</span><span style="color:#b3261e;">◆</span></>)}
          </div>
        ))}
      </div>
    </div>

    <!-- Why modernize -->
    <section id="modernize" class="dots-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
        <div style="max-width:720px;margin-bottom:56px;">
          <div class="tick" style="margin-bottom:16px;"></div>
          <div class="eyebrow" style="margin-bottom:18px;">Why modernize</div>
          <h2 style="font-size:clamp(30px,3.6vw,46px);line-height:1.08;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0 0 18px;">You can't improve what you can't measure.</h2>
          <p style="font-size:18px;line-height:1.6;color:#566169;margin:0;">"Industry 4.0" just means connecting your equipment so it produces data — then using that data to run a smarter operation. You don't need to understand the buzzwords. Here's what it actually gets you.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1px;background:#e6e9ec;border:1px solid #e6e9ec;border-radius:12px;overflow:hidden;">
          {why.map((w) => (
            <div style="background:#fff;padding:32px;">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#9aa4ad;margin-bottom:20px;">{w.n}</div>
              <h3 style="font-size:20px;font-weight:600;color:#16202a;margin:0 0 12px;letter-spacing:-0.01em;">{w.title}</h3>
              <p style="font-size:15px;line-height:1.6;color:#566169;margin:0;">{w.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services preview -->
    <section id="services" class="dots-grey" style="border-top:1px solid #e6e9ec;border-bottom:1px solid #e6e9ec;">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
        <div style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:flex-end;margin-bottom:48px;">
          <div style="max-width:640px;">
            <div class="tick" style="margin-bottom:16px;"></div>
            <div class="eyebrow" style="margin-bottom:18px;">What we do</div>
            <h2 style="font-size:clamp(30px,3.6vw,46px);line-height:1.08;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0 0 16px;">Services</h2>
            <p style="font-size:18px;line-height:1.6;color:#566169;margin:0;">Hands-on consulting across automation, controls, and process improvement — plus the data foundation to keep getting better.</p>
          </div>
          <a href="/services" style="display:inline-flex;align-items:center;gap:8px;color:#b3261e;font-size:15px;font-weight:500;white-space:nowrap;">All services in detail <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1px;background:#e6e9ec;border:1px solid #e6e9ec;border-radius:12px;overflow:hidden;">
          {services.map((s) => (
            <div class="card-hover" style="background:#fff;padding:30px;position:relative;">
              <div style="position:absolute;left:0;top:24px;width:2px;height:38px;background:#b3261e;"></div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;"><img src={`/icons/${s.icon}.svg`} width="30" height="30" alt="" /><span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#9aa4ad;">{s.n}</span></div>
              <h3 style="font-size:19px;font-weight:600;color:#16202a;margin:0 0 10px;letter-spacing:-0.01em;">{s.title}</h3>
              <p style="font-size:14.5px;line-height:1.6;color:#566169;margin:0;">{s.copy}</p>
            </div>
          ))}
          <a href="/services" class="card-dark-hover" style="background:#131c24;padding:30px;display:flex;flex-direction:column;justify-content:space-between;min-height:180px;color:#fff;">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#9aa4ad;">Not sure where to start?</div>
            <div>
              <div style="font-size:19px;font-weight:600;color:#fff;margin-bottom:14px;line-height:1.3;">Let's talk through your problem — free, no commitment.</div>
              <span style="display:inline-flex;align-items:center;gap:8px;color:#fff;font-size:15px;font-weight:500;">See all services <span style="font-family:'IBM Plex Mono',monospace;color:#b3261e;">→</span></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Lightwell Platform promo -->
    <section style="background:#131c24;color:#fff;position:relative;overflow:hidden;">
      <div class="grid-dark-overlay"></div>
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;position:relative;display:flex;flex-wrap:wrap;gap:56px;align-items:center;">
        <div style="flex:1 1 420px;min-width:300px;">
          <div style="display:inline-flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#b3261e;font-weight:500;margin-bottom:22px;background:rgba(179,38,30,0.12);border:1px solid rgba(179,38,30,0.35);padding:7px 14px;border-radius:100px;">
            <span style="display:inline-block;width:7px;height:7px;border-radius:100px;background:#b3261e;"></span> Coming soon — the Lightwell Platform
          </div>
          <h2 style="font-size:clamp(30px,3.8vw,50px);line-height:1.06;letter-spacing:-0.02em;font-weight:600;color:#fff;margin:0 0 20px;">KPI tracking, without the IT project.</h2>
          <p style="font-size:18px;line-height:1.65;color:#c3ccd3;margin:0 0 28px;max-width:520px;">Unobtrusive Lightwell sensors automatically track your key manufacturing metrics and stream them into the Lightwell database on-site, where the Lightwell dashboard turns them into precise visibility — without rewiring your plant, sending data to the cloud, or hiring a data team.</p>
          <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:32px;">
            <div style="display:flex;align-items:center;gap:12px;color:#e4e9ec;font-size:15.5px;"><span style="color:#b3261e;font-family:'IBM Plex Mono',monospace;">→</span> Lightwell sensors — wireless, standard wall power, no rewiring or plant downtime</div>
            <div style="display:flex;align-items:center;gap:12px;color:#e4e9ec;font-size:15.5px;"><span style="color:#b3261e;font-family:'IBM Plex Mono',monospace;">→</span> The Lightwell database — every cycle, stoppage and part captured on-site, never in the cloud</div>
            <div style="display:flex;align-items:center;gap:12px;color:#e4e9ec;font-size:15.5px;"><span style="color:#b3261e;font-family:'IBM Plex Mono',monospace;">→</span> The Lightwell dashboard — tracked, displayed and compared, in real time</div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a href="/lightwell#pilot" class="btn-red">Join the pilot <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
            <a href="/lightwell" class="btn-ghost-dark">Learn about the Lightwell Platform</a>
          </div>
        </div>
        <div style="flex:1 1 360px;min-width:280px;">
          <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:28px;backdrop-filter:blur(4px);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;font-family:'IBM Plex Mono',monospace;font-size:12px;color:#9aa4ad;letter-spacing:0.06em;">
              <span>SENSOR NETWORK</span><span style="color:#64b450;">● 4 ONLINE</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;">
              {sensors.map((s) => (
                <div style="border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:16px;">
                  <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;"><span style={`width:8px;height:8px;border-radius:100px;background:${s.dot};display:inline-block;`}></span><span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#9aa4ad;">{s.id}</span></div>
                  <div style="font-size:22px;font-weight:600;color:#fff;">{s.pct}<span style="font-size:13px;color:#9aa4ad;">%</span></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section id="process" class="dots-grey" style="border-top:1px solid #e6e9ec;border-bottom:1px solid #e6e9ec;">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
        <div style="max-width:640px;margin-bottom:56px;">
          <div class="tick" style="margin-bottom:16px;"></div>
          <div class="eyebrow" style="margin-bottom:18px;">How it works</div>
          <h2 style="font-size:clamp(30px,3.6vw,46px);line-height:1.08;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0;">A clear path, start to finish.</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:32px;">
          {steps.map((s) => (
            <div>
              <div style="width:56px;height:56px;border:1.5px solid #b3261e;border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:18px;color:#b3261e;margin-bottom:22px;">{s.n}</div>
              <h3 style="font-size:19px;font-weight:600;color:#16202a;margin:0 0 10px;">{s.title}</h3>
              <p style="font-size:15px;line-height:1.6;color:#566169;margin:0;">{s.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="dots-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
        <div style="max-width:680px;margin-bottom:56px;">
          <div class="tick" style="margin-bottom:16px;"></div>
          <div class="eyebrow" style="margin-bottom:18px;">Who we are</div>
          <h2 style="font-size:clamp(30px,3.6vw,46px);line-height:1.08;letter-spacing:-0.02em;font-weight:600;color:#16202a;margin:0 0 18px;">A small firm with deep manufacturing roots.</h2>
          <p style="font-size:18px;line-height:1.6;color:#566169;margin:0;">Frontier MFG pairs hands-on manufacturing and process expertise with four decades of senior hardware and software experience. You work directly with the people doing the work — no account managers, no handoffs.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;">
          <div style="border:1px solid #e6e9ec;border-radius:14px;padding:32px;background:#fff;">
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:22px;">
              <div style="width:64px;height:64px;border-radius:14px;flex-shrink:0;background:#16202a;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:20px;font-weight:500;letter-spacing:0.04em;color:#fff;position:relative;">MW<span style="position:absolute;top:9px;right:9px;width:7px;height:7px;background:#b3261e;border-radius:1px;transform:rotate(45deg);"></span></div>
              <div>
                <div style="font-size:19px;font-weight:600;color:#16202a;">Mike Wait</div>
                <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#b3261e;margin-top:3px;">Founder &amp; Principal Consultant</div>
              </div>
            </div>
            <p style="font-size:15px;line-height:1.65;color:#566169;margin:0 0 16px;">Mechanical engineer (EIT) with a B.Eng from BCIT and 20 years of hands-on manufacturing experience — automated machinery design, robotics, production commissioning, CNC machining, tooling and fixture development, and steel and aluminum fabrication and welding.</p>
            <p style="font-size:15px;line-height:1.65;color:#566169;margin:0;">Focused on practical solutions for real production-floor challenges: process optimization, equipment integration, and ramp-up troubleshooting.</p>
          </div>
          <div style="border:1px solid #e6e9ec;border-radius:14px;padding:32px;background:#fff;">
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:22px;">
              <div style="width:64px;height:64px;border-radius:14px;flex-shrink:0;background:#16202a;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:20px;font-weight:500;letter-spacing:0.04em;color:#fff;position:relative;">GW<span style="position:absolute;top:9px;right:9px;width:7px;height:7px;background:#b3261e;border-radius:1px;transform:rotate(45deg);"></span></div>
              <div>
