---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import BookCta from '../components/BookCta.astro';
import { services } from '../data/site';
import { getCaseStudies } from '../data/content';

const method = [
  { n: '01', title: 'See it', copy: 'We walk your floor, talk to your operators, and pull the records you already keep.' },
  { n: '02', title: 'Measure it', copy: 'We turn what we find into a baseline of where your hours and output go, in dollars.' },
  { n: '03', title: 'Automate it', copy: 'We fix what pays back fastest, then measure again against the same baseline.' },
];

const assessmentIn = ['Floor walk', 'Operator interviews', 'Your records: production counts, downtime, scrap, overtime'];
const assessmentOut = ['A baseline in hours and dollars', 'Fixes ranked by payback', 'A savings and payback estimate'];

// Proof section. Stays hidden until the first case study is published in
// src/content/case-studies; it then appears with no code change.
const caseStudies = (await getCaseStudies()).slice(0, 3);
---
<Base
  title="Practical Automation for BC Manufacturers — Frontier MFG"
  description="Practical automation and robotics for BC manufacturers. We measure where time and output go, then automate what pays back fastest."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="dots-hero" style="border-bottom:1px solid var(--border);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,96px) 32px;display:flex;flex-wrap:wrap;gap:56px;align-items:center;">
        <div style="flex:1 1 440px;min-width:min(100%,300px);">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <span style="display:block;width:32px;height:2px;background:var(--color-accent);"></span>
            <span class="eyebrow">Automation &amp; systems integration</span>
          </div>
          <h1 style="font-size:clamp(36px,5.2vw,68px);line-height:1.04;letter-spacing:-0.025em;font-weight:600;color:var(--color-text);margin:0 0 22px;text-wrap:balance;">Practical automation for BC manufacturers.</h1>
          <p style="font-size:18px;line-height:1.6;color:var(--color-body);margin:0 0 32px;max-width:520px;">Modernize your shop and increase productivity, starting with measured data, not guesses.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:14px;">
            <a href="/contact" class="btn-red">Book a Productivity Assessment <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
            <a href="/how-it-works" class="btn-outline">See how it works</a>
          </div>
          <div style="font-size:13.5px;color:var(--color-muted);margin:0 0 36px;">A short on-site audit that ends with a savings and payback estimate.</div>
          <div style="display:flex;flex-wrap:wrap;gap:10px 22px;align-items:center;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.03em;color:var(--color-body);">
            <span>In the trades since 2011</span>
            <span style="color:var(--color-muted);">/</span>
            <span>B.Eng, EIT</span>
            <span style="color:var(--color-muted);">/</span>
            <span style="display:inline-flex;align-items:center;gap:7px;"><img src="/icons/maple-leaf-from-the-flag-of-Canada.svg" width="14" height="14" alt="Canada" /> Lower Mainland, BC</span>
          </div>
        </div>

        <!-- What an assessment takes in, and what it gives back -->
        <div style="flex:1 1 380px;min-width:min(100%,300px);">
          <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:28px;">
            <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px 12px;margin-bottom:22px;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--color-muted);letter-spacing:0.06em;">
              <span>PRODUCTIVITY ASSESSMENT</span><span style="color:var(--color-ok);white-space:nowrap;">● ON-SITE</span>
            </div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);margin-bottom:12px;">What we look at</div>
            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:22px;">
              {assessmentIn.map((t) => (
                <div style="border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:12px 14px;font-size:15px;line-height:1.45;color:var(--color-body);">{t}</div>
              ))}
            </div>
            <div aria-hidden="true" style="text-align:center;font-family:'IBM Plex Mono',monospace;color:var(--color-accent-text);margin:-8px 0 10px;">↓</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);margin-bottom:12px;">What you get</div>
            <div style="display:flex;flex-direction:column;gap:10px;">
              {assessmentOut.map((t) => (
                <div style="display:flex;gap:10px;align-items:baseline;background:var(--color-surface);border-radius:10px;padding:12px 14px;font-size:15px;line-height:1.45;color:var(--color-text);"><span style="color:var(--color-accent-text);font-family:'IBM Plex Mono',monospace;">→</span>{t}</div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Method -->
    <section id="method" class="dots-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
        <SectionHead eyebrow="Our method" title="See it, measure it, automate it." lead="Most automation pitches start with a machine. Ours starts with your numbers, so you know what a project is worth before you spend on it." />
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:32px;">
          {method.map((s) => (
            <div>
              <div style="width:56px;height:56px;border:1.5px solid var(--color-accent);border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:18px;color:var(--color-accent-text);margin-bottom:22px;">{s.n}</div>
              <h3 style="font-size:20px;font-weight:600;color:var(--color-text);margin:0 0 10px;">{s.title}</h3>
              <p style="font-size:15.5px;line-height:1.6;color:var(--color-body);margin:0;">{s.copy}</p>
            </div>
          ))}
        </div>
        <a href="/how-it-works" style="display:inline-flex;align-items:center;gap:8px;margin-top:44px;color:var(--color-accent-text);font-size:15px;font-weight:500;">How it works, step by step <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
      </div>
    </section>

    <!-- What we automate -->
    <section id="services" class="dots-grey" style="border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
        <div style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:flex-end;margin-bottom:48px;">
          <SectionHead eyebrow="Services" title="What we automate." lead="Every project starts with an assessment, so the fix fits the problem." maxWidth={640} gap={0} />
          <a href="/services" style="display:inline-flex;align-items:center;gap:8px;color:var(--color-accent-text);font-size:15px;font-weight:500;white-space:nowrap;">All services in detail <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
        </div>
        <div class="grid-even" style="gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden;">
          {services.map((s) => (
            <a href={`/services#${s.id}`} class="card-hover" style="background:var(--color-surface);padding:30px;position:relative;display:flex;flex-direction:column;color:var(--color-text);">
              <div style="position:absolute;left:0;top:24px;width:2px;height:38px;background:var(--color-accent);"></div>
              <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;"><img src={`/icons/${s.icon}.svg`} width="30" height="30" alt="" />{'inDevelopment' in s && <span class="pill-soon">IN DEVELOPMENT</span>}</div>
              <h3 style="font-size:19px;font-weight:600;color:var(--color-text);margin:0 0 10px;letter-spacing:-0.01em;">{s.title}</h3>
              <p style="font-size:14.5px;line-height:1.6;color:var(--color-body);margin:0 0 18px;">{s.summary}</p>
              <span style="margin-top:auto;font-family:'IBM Plex Mono',monospace;color:var(--color-accent-text);">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {caseStudies.length > 0 && (
      <!-- Proof: case studies -->
      <section id="proof" class="dots-white" style="border-bottom:1px solid var(--border);">
        <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
          <SectionHead eyebrow="Case studies" title="Automation backed by your own numbers." lead="Each project is measured before and after against the same baseline." />
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px;">
            {caseStudies.map((c) => (
              <a href={`/case-studies/${c.id}`} class="card-hover" style="display:flex;flex-direction:column;border:1px solid var(--border);border-radius:14px;padding:30px;background:var(--color-bg-alt);color:var(--color-text);">
                {c.data.industry && <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);margin-bottom:14px;">{c.data.industry}</div>}
                <h3 style="font-size:20px;font-weight:600;margin:0 0 10px;">{c.data.title}</h3>
                <p style="font-size:15px;line-height:1.6;color:var(--color-body);margin:0 0 18px;">{c.data.description}</p>
                <span style="margin-top:auto;color:var(--color-accent-text);font-size:15px;font-weight:500;">Read the case study →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Payback calculator teaser -->
    <section class="dots-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;display:flex;flex-wrap:wrap;gap:48px;align-items:center;">
        <div style="flex:1 1 420px;min-width:min(100%,300px);">
          <SectionHead eyebrow="Payback calculator" title="Run the payback math yourself." lead="Enter the labour hours, scrap, and downtime a project would save, and what it would cost. You'll get a rough payback period in a minute. Nothing you type leaves your browser." gap={32} />
          <a href="/payback-calculator" class="btn-outline">Open the payback calculator <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
        </div>
        <div style="flex:1 1 340px;min-width:min(100%,280px);">
          <div style="background:var(--color-surface);border:1px solid var(--border);border-radius:16px;padding:28px;">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-muted);margin-bottom:16px;">The basic formula</div>
            <div style="font-size:clamp(18px,2.2vw,22px);line-height:1.45;font-weight:600;color:var(--color-text);">Payback (months) = project cost ÷ monthly savings</div>
            <p style="font-size:14.5px;line-height:1.6;color:var(--color-body);margin:16px 0 0;">Savings come from labour, scrap, and downtime. Downtime only counts on the machine that limits your output.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- id="contact" keeps old /#contact links landing on a booking prompt. -->
    <BookCta id="contact" />

  </main>
  <Footer />
</Base>
