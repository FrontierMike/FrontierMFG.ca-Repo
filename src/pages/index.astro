<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const status = document.getElementById('contact-status')!;
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.style.color = ok ? '#7ecb9a' : '#f2495c';
      status.style.display = 'block';
    };
    btn.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      const out = await res.json();
      if (out.ok) {
        show("Thanks — we'll be in touch within one business day.", true);
        form.reset();
      } else {
        show(out.error || 'Could not send your message. Please email info@frontiermfg.ca directly.', false);
      }
    } catch {
      show('Could not send your message. Please email info@frontiermfg.ca directly.', false);
    }
    btn.disabled = false;
  });
</script>
