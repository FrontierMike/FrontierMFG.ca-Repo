---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import EngagementProcess from '../components/EngagementProcess.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const title = "Services | Frontier Manufacturing Services";
const description = "Automation, PLC/SCADA, controls, integration, process improvement, feasibility, DFM, and machining consultation for manufacturers across Western Canada — plus BASELINE shop-floor monitoring. Free 30-minute consultation.";
---
<Base title={title} description={description}>
  <Nav />
  <main>
    <PageHero
      eyebrow="Automation & manufacturing consulting"
      title="Services"
      subtitle="Practical, hands-on help across automation, controls, and process — available today. We scope the work, prove it's worth doing, and build it ourselves."
    />

    <ServicesGrid />

    <!-- BASELINE monitoring: one highlighted offering, coming soon -->
    <section class="bg-page py-20 md:py-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="bg-band rounded-2xl p-8 md:p-12 overflow-hidden">
          <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16 items-center">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-white font-bold text-[20px]">BASELINE</span>
                <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-white/70 border border-white/25 rounded-full px-3 py-1">Pilot — coming soon</span>
              </div>
              <h2 class="text-white font-bold text-[24px] md:text-[28px] mb-4 leading-tight">
                Shop-floor monitoring &amp; OEE
              </h2>
              <p class="text-white/65 text-[15.5px] leading-relaxed mb-6 max-w-xl">
                You can't fix what you can't see. BASELINE is our own manufacturing IoT
                platform — a small kit that clamps onto the machines you already run and
                streams live OEE, downtime, and MTBF to a dashboard on your network, in
                days. It's how we measure before we automate, and it can stay in place to
                prove the gains hold.
              </p>
              <div class="flex flex-wrap items-center gap-6">
                <a
                  href="/what-is-oee"
                  class="text-[#e25a4f] hover:text-white font-medium text-[15px] transition-colors duration-200"
                >
                  What is OEE? →
                </a>
                <a
                  href="/baseline"
                  class="text-white/60 hover:text-white font-medium text-[15px] transition-colors duration-200"
                >
                  See a live dashboard →
                </a>
              </div>
            </div>
            <ul class="flex flex-col gap-3">
              {[
                "Live OEE, downtime & MTBF in days",
                "No PLC changes, no line stoppage",
                "Your data stays on your own network",
                "Hardware that costs less than a day of downtime",
              ].map((f) => (
                <li class="flex items-start gap-3 text-white/70 text-[15px] leading-relaxed">
                  <span class="text-[#e25a4f] font-bold mt-0.5 flex-shrink-0">→</span>{f}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <EngagementProcess />
    <CTASection />
  </main>
  <Footer />
</Base>
