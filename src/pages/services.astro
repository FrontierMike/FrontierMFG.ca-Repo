---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import EngagementProcess from '../components/EngagementProcess.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const title = "Services | Frontier Manufacturing Services";
const description = "Automation, PLC/SCADA, controls, integration, process improvement, feasibility, DFM, and machining consultation for manufacturers across Western Canada — plus BASELINE shop-floor monitoring. Free 30-minute consultation.";
---
<Base title={title} description={description}>
  <Nav />
  <main>
    <PageHero
      eyebrow="Automation & Manufacturing Consulting"
      title="Services"
      subtitle="Practical, hands-on help across automation, controls, and process — available today. We scope the work, prove it's worth doing, and build it ourselves."
    />

    <ServicesGrid />

    <!-- BASELINE monitoring: one highlighted offering, coming soon -->
    <section class="bg-card py-24 border-t border-white/7">
      <div class="max-w-7xl mx-auto px-6">
        <div class="relative bg-surface border border-white/7 p-8 md:p-12 overflow-hidden">
          <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-accent"></div>
          <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16 items-center">
            <div>
              <div class="flex items-center gap-3 mb-5">
                <span class="font-display font-extrabold text-[22px] uppercase tracking-[0.08em] text-primary">BASELINE</span>
                <span class="font-display text-[10px] font-bold tracking-[0.18em] uppercase text-muted border border-white/15 px-2 py-1">Pilot — Coming Soon</span>
              </div>
              <h2 class="font-display font-bold text-[24px] md:text-[28px] uppercase tracking-[0.04em] text-primary mb-4 leading-tight">
                Shop-Floor Monitoring & OEE
              </h2>
              <p class="text-muted text-[15px] leading-relaxed mb-6 max-w-xl">
                You can't fix what you can't see. BASELINE is our own manufacturing IoT
                platform — a small kit that clamps onto the machines you already run and
                streams live OEE, downtime, and MTBF to a dashboard on your network, in
                days. It's how we measure before we automate, and it can stay in place to
                prove the gains hold.
              </p>
              <div class="flex flex-wrap items-center gap-6">
                <a
                  href="/what-is-oee"
                  class="font-display font-semibold text-[13px] tracking-[0.1em] uppercase text-accent hover:text-accent-dark transition-colors duration-200"
                >
                  What is OEE? →
                </a>
                <a
                  href="/#baseline"
                  class="font-display font-semibold text-[13px] tracking-[0.1em] uppercase text-muted hover:text-accent transition-colors duration-200"
                >
                  See a live dashboard →
                </a>
              </div>
            </div>
            <ul class="flex flex-col gap-3">
              {[
                "Live OEE, downtime & MTBF in days",
                "No PLC changes, no line stoppage",
                "Your data stays on your own network",
                "Hardware that costs less than a day of downtime",
              ].map((f) => (
                <li class="flex items-start gap-3 text-muted text-[14px] leading-relaxed">
                  <span class="text-accent mt-0.5 flex-shrink-0">→</span>{f}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <EngagementProcess />
    <CTASection />
  </main>
  <Footer />
</Base>
