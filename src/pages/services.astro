---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import BookCta from '../components/BookCta.astro';
import { serviceArea, services } from '../data/site';
import { ORG_ID } from '../data/schema';

// Long-form copy per service, keyed by the ids in src/data/site.ts.
const detail: Record<(typeof services)[number]['id'], { what: string; who: string[]; get: string[]; cta: string; link?: { href: string; label: string } }> = {
  assessment: {
    what: 'A short on-site audit of your shop. We walk the floor, talk to your operators, and go through the records you already keep. You get an estimate of what you could save, and how fast a project would pay for itself.',
    who: [
      "Owners who know they're losing time or output, but can't say exactly where",
      'Shops weighing an automation project that want the numbers first',
      "Anyone who has been quoted a robot and isn't sure it pays",
    ],
    get: [
      'A baseline of where your hours, scrap, and downtime go',
      'A short list of fixes, ranked by payback',
      'A savings and payback estimate built from your own numbers',
    ],
    cta: 'Book a Productivity Assessment',
  },
  'robot-cells': {
    what: 'A cobot (collaborative robot) or industrial robot cell takes over a repetitive job: loading and unloading a machine, moving parts from one place to another, or a manual station that ties up a person all shift.',
    who: [
      'Shops running the same parts again and again',
      'Operators stuck tending a machine instead of running the shop',
      'Stations that are hard to staff',
    ],
    get: [
      'A cell sized to the job and your volume',
      'Payback worked out from your measured numbers before you commit',
      'Integration, start-up, and operator training',
    ],
    cta: 'Start with an assessment',
  },
  'controls-retrofits': {
    what: "Plenty of older machines are still mechanically sound but run on outdated controls: obsolete PLCs (programmable logic controllers), relay logic, or parts you can't buy anymore. A retrofit replaces the controls and keeps the machine.",
    who: [
      'Machines that are solid but getting hard to keep running',
      'Equipment with controllers or parts that are no longer supported',
      'Shops where one person is the only one who knows how the old logic works',
    ],
    get: [
      'Up-to-date controls on the machine you already own',
      'Documentation your team can work from',
      'A straight comparison against replacing the machine',
    ],
    cta: 'Start with an assessment',
  },
  'machine-monitoring': {
    what: "Machine monitoring records when each machine runs, stops, and makes parts, so your baseline keeps itself current instead of being a one-time snapshot. We're developing our own system for this, Lightwell; it isn't available to install yet.",
    who: ['Shops that want running numbers on their machines, not a one-time study'],
    get: ['Today, the same measurements by time study and from your own records, as part of a Productivity Assessment'],
    cta: 'Start with an assessment',
    link: { href: '/how-it-works#measure', label: 'How we measure today' },
  },
};

const serviceSchema = services.map((s) => ({
  '@type': 'Service',
  name: s.title,
  description: detail[s.id].what,
  serviceType: s.title,
  provider: { '@id': ORG_ID },
  areaServed: serviceArea.map((city) => ({ '@type': 'City', name: city })),
}));

const listLabel = "font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-muted);margin:0 0 12px;";
---
<Base
  title="Automation Services: Assessments, Robot Cells, Controls Retrofits — Frontier MFG"
  description="Productivity assessments, cobot and robot cells, and controls retrofits for older equipment, for small and mid-size BC manufacturers."
  breadcrumb={[['Services', '/services']]}
  schema={serviceSchema}
>
  <Header />
  <main>

    <PageHero
      eyebrow="Services"
      title="Automation that starts with your numbers."
      lead="Four ways we help BC shops get more out of the equipment and people they already have. Every project starts with a Productivity Assessment."
    >
      <a href="/contact" class="btn-red">Book a Productivity Assessment <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
      <a href="/how-it-works" class="btn-outline">How it works</a>
    </PageHero>

    <section class="dots-white">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,104px) 32px;display:flex;flex-direction:column;gap:24px;">
        {services.map((s, i) => {
          const d = detail[s.id];
          return (
            <article id={s.id} style="border:1px solid var(--border);border-radius:14px;padding:clamp(26px,4vw,40px);background:var(--color-surface);scroll-margin-top:84px;">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;">
                <img src={`/icons/${s.icon}.svg`} width="32" height="32" alt="" />
                <span style="display:inline-flex;align-items:center;gap:10px;">
                  {'inDevelopment' in s && <span class="pill-soon">IN DEVELOPMENT</span>}
                  <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--color-muted);">{String(i + 1).padStart(2, '0')}</span>
                </span>
              </div>
              <h2 style="font-size:clamp(24px,2.6vw,30px);font-weight:600;color:var(--color-text);margin:0 0 14px;letter-spacing:-0.01em;">{s.title}</h2>
              <p style="font-size:17px;line-height:1.65;color:var(--color-body);margin:0 0 28px;max-width:760px;">{d.what}</p>
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:24px 40px;border-top:1px solid var(--border);padding-top:24px;margin-bottom:28px;">
                <div>
                  <h3 style={listLabel}>Who it's for</h3>
                  <ul style="display:flex;flex-direction:column;gap:9px;list-style:none;margin:0;padding:0;">
                    {d.who.map((b) => <li style="display:flex;gap:10px;font-size:15px;line-height:1.5;color:var(--color-body);"><span style="color:var(--color-accent-text);font-family:'IBM Plex Mono',monospace;">—</span>{b}</li>)}
                  </ul>
                </div>
                <div>
                  <h3 style={listLabel}>What you get</h3>
                  <ul style="display:flex;flex-direction:column;gap:9px;list-style:none;margin:0;padding:0;">
                    {d.get.map((b) => <li style="display:flex;gap:10px;font-size:15px;line-height:1.5;color:var(--color-body);"><span style="color:var(--color-accent-text);font-family:'IBM Plex Mono',monospace;">→</span>{b}</li>)}
                  </ul>
                </div>
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:14px 24px;align-items:center;">
                <a href="/contact" class={s.id === 'assessment' ? 'btn-red' : 'btn-outline'}>{d.cta} <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>
                {d.link && <a href={d.link.href} style="display:inline-flex;align-items:center;gap:8px;font-size:15px;font-weight:500;color:var(--color-accent-text);">{d.link.label} <span style="font-family:'IBM Plex Mono',monospace;">→</span></a>}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <BookCta title="Not sure which one you need?" copy="That's what the assessment is for. We look at your floor and your numbers first, then tell you which fix pays back fastest, including when the answer is a fixture and not a robot." />

  </main>
  <Footer />
</Base>
