---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookCta from '../../components/BookCta.astro';
import DimensionLine from '../../components/DimensionLine.astro';
import { SITE_URL, abs } from '../../data/site';
import { ORG_ID } from '../../data/schema';
import { getLearnArticles, learnCategories } from '../../data/content';

export const getStaticPaths = (async () =>
  (await getLearnArticles()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, pubDate, draft } = entry.data;
const categoryLabel = learnCategories.find((c) => c.id === category)?.label ?? category;
const dateFmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleSchema = [{
  '@type': 'Article',
  '@id': `${abs(`/learn/${entry.id}`)}#article`,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: { '@id': `${SITE_URL}/#mike-wait` },
  publisher: { '@id': ORG_ID },
}];
---
<Base
  title={`${title} — Frontier MFG`}
  description={description}
  breadcrumb={[['Learn', '/learn'], [title, `/learn/${entry.id}`]]}
  schema={articleSchema}
  noindex={draft}
>
  <Header />
  <main>
    <article>
      <header class="band-dark blueprint" style="border-bottom:1px solid var(--line);">
        <div class="wrap" style="max-width:880px;padding-block:clamp(56px,7vw,96px);">
          <a href="/learn" class="nav-link" style="display:inline-flex;align-items:center;gap:8px;font-size:14px;margin-bottom:26px;"><ArrowLeft size={16} stroke-width={1.75} aria-hidden="true" /> Learn</a>
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;margin-bottom:20px;">
            <span class="label">{categoryLabel}</span>
            <span class="label-muted">{dateFmt.format(pubDate)}</span>
            {draft && <span class="pill">Draft · not published</span>}
          </div>
          <h1 class="display h1" style="font-size:clamp(2.5rem,1.7rem+3.4vw,4rem);">{title}</h1>
          <DimensionLine class="mt-6" />
          <p class="lead" style="margin-top:24px;">{description}</p>
        </div>
      </header>

      <div class="band-light">
        <div class="wrap prose-article" style="max-width:880px;padding-block:clamp(56px,7vw,96px);">
          <Content />
        </div>
      </div>
    </article>

    <!-- Every article ends with the calculator link and the booking CTA. -->
    <BookCta>
      <p style="font-size:15.5px;margin:30px 0 0;">Want a rough number first? <a href="/payback-calculator" class="link">Try the payback calculator</a></p>
    </BookCta>
  </main>
  <Footer />
</Base>
