---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactForm from '../components/ContactForm.astro';
import { business, serviceAreaGroups, telHref } from '../data/site';

// Name / address / phone shown in the contact block. Sourced from src/data/site.ts
// so the details here and the details in the structured data can never drift.
const contactRows = [
  { label: 'EMAIL', value: business.email, href: `mailto:${business.email}` },
  ...(business.phone ? [{ label: 'PHONE', value: business.phone, href: telHref }] : []),
  { label: 'LOCATION', value: `${business.locality}, ${business.regionName}` },
  { label: 'SERVING', value: 'Vancouver, the Lower Mainland & Fraser Valley' },
];

const covers = [
  'A walk of your floor',
  'Short interviews with your operators',
  'Your own records: production counts, downtime, scrap, and overtime',
  'A savings and payback estimate',
];
---
<Base
  title="Book a Productivity Assessment — Frontier MFG"
  description="Book a Productivity Assessment: a short on-site audit for BC manufacturers that ends with a savings and payback estimate built from your own numbers."
  breadcrumb={[['Contact', '/contact']]}
>
  <Header />
  <main>

    <section style="background:var(--color-bg);color:var(--color-text);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,96px) 32px;display:flex;flex-wrap:wrap;gap:56px;">
        <div style="flex:1 1 380px;min-width:min(100%,300px);">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:22px;">
            <span style="display:block;width:32px;height:2px;background:var(--color-accent);"></span>
            <span class="eyebrow">Book an assessment</span>
          </div>
          <h1 style="font-size:clamp(34px,4.4vw,54px);line-height:1.06;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0 0 20px;text-wrap:balance;">Book a Productivity Assessment.</h1>
          <p style="font-size:18px;line-height:1.65;color:var(--color-body);margin:0 0 40px;max-width:480px;">A short on-site audit of your shop that ends with a savings and payback estimate. Tell us a little about your shop and we'll reply within one business day. Questions about anything else are welcome too.</p>
          <div style="display:flex;flex-direction:column;gap:20px;">
            {contactRows.map((row, i) => (
              <>
                {i > 0 && <div style="height:1px;background:rgba(255,255,255,0.08);"></div>}
                <div style="display:flex;align-items:center;gap:14px;">
                  <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:var(--color-muted);width:80px;flex-shrink:0;">{row.label}</span>
                  {row.href
                    ? <a href={row.href} style="font-size:16px;color:var(--color-body);overflow-wrap:anywhere;">{row.value}</a>
                    : <span style="font-size:16px;color:var(--color-body);">{row.value}</span>}
                </div>
              </>
            ))}
          </div>
          <div style="margin-top:36px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px;">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-muted);margin-bottom:14px;">What the assessment covers</div>
            <div style="display:flex;flex-direction:column;gap:11px;">
              {covers.map((c, i) => (
                <div style="display:flex;gap:12px;font-size:15px;line-height:1.5;color:var(--color-body);"><span style="color:var(--color-accent-text);font-family:'IBM Plex Mono',monospace;">{String(i + 1).padStart(2, '0')}</span> {c}</div>
              ))}
            </div>
          </div>
        </div>
        <div style="flex:1 1 420px;min-width:min(100%,300px);">
          <ContactForm />
        </div>
      </div>
    </section>

    <!-- Service area -->
    <section id="service-area" class="dots-grey" style="border-top:1px solid var(--border);">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) 32px;">
        <SectionHead
          eyebrow="Service area"
          title="On your floor, anywhere in the Lower Mainland."
          lead={`An assessment happens on your floor, not over email. We're based in ${business.locality}, ${business.regionName}, and we drive out to shops across Metro Vancouver and the Fraser Valley.`}
          gap={48}
        />
        <div class="grid-even" style="gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden;">
          {serviceAreaGroups.map((g) => (
            <div style="background:var(--color-surface);padding:28px;">
              <h3 style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent-text);font-weight:500;margin:0 0 16px;">{g.label}</h3>
              <ul style="display:flex;flex-direction:column;gap:9px;list-style:none;margin:0;padding:0;">
                {g.cities.map((c) => (
                  <li style="font-size:15px;line-height:1.4;color:var(--color-body);">{c}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p style="font-size:15px;line-height:1.6;color:var(--color-muted);margin:22px 0 0;max-width:660px;">Further afield, like the Interior, Vancouver Island, or Alberta, is workable for larger projects. Ask and we'll tell you honestly whether the travel makes sense.</p>
      </div>
    </section>

  </main>
  <Footer />
</Base>
