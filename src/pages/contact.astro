---
import { MapPin } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactForm from '../components/ContactForm.astro';
import { business, serviceAreaGroups, telHref } from '../data/site';

// Name / address / phone shown in the contact block. Sourced from src/data/site.ts
// so the details here and the details in the structured data can never drift.
const contactRows = [
  { label: 'Email', value: business.email, href: `mailto:${business.email}` },
  ...(business.phone ? [{ label: 'Phone', value: business.phone, href: telHref }] : []),
  { label: 'Location', value: `${business.locality}, ${business.regionName}` },
  { label: 'Serving', value: 'Metro Vancouver & the Fraser Valley' },
];

const covers = [
  'A walk of your floor',
  'Short interviews with your operators',
  'Your own records: production counts, downtime, scrap, and overtime',
  'A savings and payback estimate',
];
---
<Base
  title="Book a Productivity Assessment — Frontier MFG"
  description="Book a Productivity Assessment: a short on-site audit for BC manufacturers that ends with a savings and payback estimate built from your own numbers."
  breadcrumb={[['Contact', '/contact']]}
>
  <Header />
  <main>

    <PageHero
      eyebrow="Book an assessment"
      title="Book a Productivity Assessment."
      lead="A short on-site audit of your shop that ends with a savings and payback estimate. Tell us a little about your shop and we'll reply within one business day. Questions about anything else are welcome too."
    />

    <section class="band-light blueprint section">
      <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] items-start">
        <div>
          <dl style="margin:0;display:flex;flex-direction:column;">
            {contactRows.map((row, i) => (
              <div style={`display:grid;grid-template-columns:96px 1fr;gap:14px;align-items:baseline;padding:16px 0;${i > 0 ? 'border-top:1px solid var(--line);' : ''}`}>
                <dt class="label-muted">{row.label}</dt>
                <dd style="margin:0;font-size:17px;color:var(--text);overflow-wrap:anywhere;">
                  {row.href ? <a href={row.href} class="link" style="font-weight:500;">{row.value}</a> : row.value}
                </dd>
              </div>
            ))}
          </dl>
          <div class="card" style="margin-top:32px;padding:26px;">
            <div class="label" style="margin-bottom:16px;">What the assessment covers</div>
            <ol style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
              {covers.map((c, i) => (
                <li style="display:flex;gap:14px;font-size:16px;line-height:1.5;"><span class="mono" style="color:var(--accent-text);font-weight:500;">{String(i + 1).padStart(2, '0')}</span> {c}</li>
              ))}
            </ol>
          </div>
        </div>
        <div>
          <ContactForm />
        </div>
      </div>
    </section>

    <!-- Service area -->
    <section id="service-area" class="band-dark blueprint section">
      <div class="wrap">
        <SectionHead
          eyebrow="Service area"
          title="On your floor, anywhere in Metro Vancouver and the Fraser Valley."
          lead={`An assessment happens on your floor, not over email. We're based in ${business.locality}, ${business.regionName}, and we drive out to shops across the region.`}
          gap={48}
        />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {serviceAreaGroups.map((g, i) => (
            <div class="card" data-reveal style={`--reveal-delay:${i * 70}ms;padding:26px;`}>
              <h3 class="label" style="display:flex;align-items:center;gap:8px;margin:0 0 16px;"><MapPin size={16} stroke-width={1.75} aria-hidden="true" /> {g.label}</h3>
              <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;">
                {g.cities.map((c) => <li style="font-size:15.5px;line-height:1.4;">{c}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p style="font-size:15.5px;line-height:1.6;color:var(--text-muted);margin:24px 0 0;max-width:660px;">Further afield, like the Interior, Vancouver Island, or Alberta, is workable for larger projects. Ask and we'll tell you honestly whether the travel makes sense.</p>
      </div>
    </section>

  </main>
  <Footer />
</Base>
