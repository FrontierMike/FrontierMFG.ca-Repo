---
// Proof point on /baseline: a real machine streaming to a real dashboard.
// Videos autoplay muted + loop so it reads as live without controls. The tall
// dashboard was screen-captured in 4 equal-width horizontal bands; stacked at
// w-full they rebuild the whole board. Lengths differ (not synced — that's fine).
const clips = [1, 2, 3, 4];
---
<section id="demo" class="bg-tint py-20 md:py-24 border-y border-line">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-10 max-w-2xl">
      <p class="text-[12px] font-semibold tracking-[0.16em] uppercase text-accent mb-3">Our monitoring platform · BASELINE</p>
      <h2 class="text-ink font-bold mb-4" style="font-size: clamp(30px, 3.5vw, 44px);">See your shop floor</h2>
      <p class="text-muted text-[16px] leading-relaxed">
        The "See" step, made real. BASELINE is our own monitoring kit — a real machine,
        streaming live OEE, availability, downtime, and mean time between failures the
        moment it's plugged in. No PLC changes, no line stoppage.
      </p>
    </div>

    <!-- Video showcase: 4 stacked bands = the full tall dashboard -->
    <div class="relative rounded-xl overflow-hidden shadow-lg border border-[#0c1116] bg-[#0c1116]" aria-label="Live production dashboard demo — OEE, downtime and machine status">
      {clips.map((n) => (
        <video
          class="block w-full h-auto"
          src={`/baseline-demo-${n}.mp4`}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      ))}
      <span class="absolute top-4 left-4 flex items-center gap-2 bg-white/90 backdrop-blur rounded-full px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.1em] text-accent shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span> Live demo
      </span>
    </div>

    <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between max-w-4xl">
      <p class="text-dim text-[14px] leading-relaxed max-w-2xl">
        Built on an open-source stack, running on hardware that costs less than a day of
        downtime, with your data staying on your own network. <span class="text-muted">BASELINE
        pilots are opening soon — automation and process consulting are available today.</span>
      </p>
      <a
        href="/what-is-oee"
        class="text-accent hover:text-accent-dark font-medium text-[15px] transition-colors duration-200 whitespace-nowrap"
      >
        New to OEE? Start here →
      </a>
    </div>

  </div>
</section>
