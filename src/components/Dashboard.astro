---
// Proof point: BASELINE, our own monitoring platform, streaming a real machine.
// Videos autoplay muted + loop so it reads as live without controls. No poster
// frame (no ffmpeg on this box) — the dark frame background covers the load flash.
// The tall dashboard was screen-captured in 4 equal-width horizontal bands; stacked
// at w-full they rebuild the whole board. Lengths differ (not synced — that's fine).
const clips = [1, 2, 3, 4];
---
<section id="baseline" class="bg-card py-24 border-t border-white/7">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-12 max-w-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-6 h-px bg-accent flex-shrink-0"></div>
        <span class="min-w-0 font-display text-[11px] font-semibold tracking-[0.22em] uppercase text-accent">Our Monitoring Platform · BASELINE</span>
      </div>
      <h2
        class="font-display font-extrabold uppercase text-primary mb-4"
        style="font-size: clamp(36px, 4vw, 56px);"
      >See Your Shop Floor</h2>
      <p class="text-muted text-[15px] leading-relaxed">
        The "See" step, made real. BASELINE is our own monitoring kit — a real machine,
        streaming live OEE, availability, downtime, and mean time between failures the
        moment it's plugged in. No PLC changes, no line stoppage.
      </p>
    </div>

    <!-- Video showcase: 4 stacked bands = the full tall dashboard -->
    <div class="relative border border-white/7 bg-[#080908] overflow-hidden" aria-label="Live production dashboard demo — OEE, downtime and machine status">
      {clips.map((n) => (
        <video
          class="block w-full h-auto"
          src={`/baseline-demo-${n}.mp4`}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      ))}
      <span class="absolute top-4 left-4 flex items-center gap-2 bg-dark/80 backdrop-blur px-3 py-1.5 font-display text-[10px] font-bold tracking-[0.18em] uppercase text-accent">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span> Live Demo
      </span>
    </div>

    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-center md:justify-between max-w-3xl">
      <p class="text-dim text-[13px] leading-relaxed max-w-2xl">
        Built on an open-source stack, running on hardware that costs less than a day of
        downtime, with your data staying on your own network. <span class="text-muted">BASELINE
        pilots are opening soon — automation and process consulting are available today.</span>
      </p>
      <a
        href="/what-is-oee"
        class="font-display font-semibold text-[13px] tracking-[0.1em] uppercase text-muted hover:text-accent transition-colors duration-200 whitespace-nowrap"
      >
        New to OEE? Start here →
      </a>
    </div>

  </div>
</section>
