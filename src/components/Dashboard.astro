---
// The "SEE" payoff: a real machine streaming to a real dashboard. Videos autoplay
// muted + loop so it reads as live without controls. ponytail: no poster frame
// (no ffmpeg on this box) — the dark frame background covers the load flash.
// The tall dashboard was screen-captured in 4 equal-width horizontal bands; stacked
// at w-full they rebuild the whole board. Lengths differ (not synced — that's fine).
const clips = [1, 2, 3, 4];
---
<section id="dashboard" class="bg-card py-24 border-t border-white/7">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-12 max-w-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-6 h-px bg-accent"></div>
        <span class="font-display text-[11px] font-semibold tracking-[0.22em] uppercase text-accent">This Is Real Data</span>
      </div>
      <h2
        class="font-display font-extrabold uppercase text-primary mb-4"
        style="font-size: clamp(36px, 4vw, 56px);"
      >See Your Shop Floor</h2>
      <p class="text-muted text-[15px] leading-relaxed">
        A real machine, streaming live — OEE, availability, downtime, and mean time
        between failures the moment it's plugged in. No PLC changes, no line stoppage.
      </p>
    </div>

    <!-- Video showcase: 4 stacked bands = the full tall dashboard -->
    <div class="relative border border-white/7 bg-[#080908] overflow-hidden" aria-label="Live production dashboard demo — OEE, downtime and machine status">
      {clips.map((n) => (
        <video
          class="block w-full h-auto"
          src={`/baseline-demo-${n}.mp4`}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      ))}
      <span class="absolute top-4 left-4 flex items-center gap-2 bg-dark/80 backdrop-blur px-3 py-1.5 font-display text-[10px] font-bold tracking-[0.18em] uppercase text-accent">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span> Live Demo
      </span>
    </div>

    <p class="text-dim text-[13px] leading-relaxed mt-5 max-w-2xl">
      We built this. Open-source stack — runs on hardware that costs less than a day of
      downtime, with your data staying on your own network.
    </p>

  </div>
</section>
