---
import { business, telHref } from '../data/site';

const year = new Date().getFullYear();

const links = [
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/services', label: 'Services' },
  { href: '/learn', label: 'Learn' },
  { href: '/payback-calculator', label: 'Payback Calculator' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<footer class="band-dark" style="border-top:1px solid var(--line);">
  <div class="wrap" style="padding-block:56px 40px;display:grid;gap:36px;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));align-items:start;">
    <div>
      <a href="/" style="display:inline-flex;align-items:center;gap:10px;color:var(--text);font-family:var(--font-display);font-weight:700;font-size:22px;letter-spacing:0.04em;">
        <span aria-hidden="true" style="display:inline-block;width:10px;height:10px;background:var(--color-safety);transform:rotate(45deg);"></span>
        FRONTIER<span style="color:var(--color-safety);">MFG</span>
      </a>
      <p style="margin:12px 0 0;font-size:15px;color:var(--text-body);">Practical automation for BC manufacturers.</p>
      <p class="label" style="margin:14px 0 0;">Based in Surrey, BC</p>
    </div>
    <nav aria-label="Footer">
      <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 24px;">
        {links.map((l) => <li><a href={l.href} class="nav-link" style="font-size:14.5px;">{l.label}</a></li>)}
      </ul>
    </nav>

    <!-- Name / address / phone, repeated on every page. Matches the contact
         page and the LocalBusiness schema exactly — see src/data/site.ts. -->
    <address class="mono" style="font-style:normal;font-size:13px;line-height:1.8;color:var(--text-body);">
      <span style="color:var(--text);">{business.legalName}</span><br />
      {business.locality}, {business.regionName}, Canada<br />
      <a href={`mailto:${business.email}`} class="nav-link" style="font-size:13px;padding:0;">{business.email}</a>
      {business.phone && <><br /><a href={telHref} class="nav-link" style="font-size:13px;padding:0;">{business.phone}</a></>}
    </address>
  </div>
  <div style="border-top:1px solid var(--line);">
    <div class="wrap mono" style="padding-block:18px;display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:space-between;font-size:12px;color:var(--text-muted);">
      <span>© {year} {business.legalName}</span>
      <span>Serving Metro Vancouver &amp; the Fraser Valley</span>
    </div>
  </div>
  <div class="hazard" aria-hidden="true"></div>
</footer>
