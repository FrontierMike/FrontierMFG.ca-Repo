---
// Eyebrow label, H2, and optional lead: the heading block that opens most
// sections. Follows the band it sits in.
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  maxWidth?: number;
  /** Space below the block, in px. */
  gap?: number;
}
const { eyebrow, title, lead, maxWidth = 760, gap = 56 } = Astro.props;
---
<div data-reveal style={`max-width:${maxWidth}px;margin-bottom:${gap}px;`}>
  <div class="label" style="margin-bottom:18px;">{eyebrow}</div>
  <h2 class="display h2">{title}</h2>
  {lead && <p class="lead" style="margin-top:20px;">{lead}</p>}
</div>
