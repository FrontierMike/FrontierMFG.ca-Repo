---
// Tick rule, eyebrow, H2, and optional lead paragraph: the heading block that
// opens most sections.
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  maxWidth?: number;
  /** Space below the block, in px. */
  gap?: number;
}
const { eyebrow, title, lead, maxWidth = 720, gap = 56 } = Astro.props;
---
<div style={`max-width:${maxWidth}px;margin-bottom:${gap}px;`}>
  <div class="tick" style="margin-bottom:16px;"></div>
  <div class="eyebrow" style="margin-bottom:18px;">{eyebrow}</div>
  <h2 style={`font-size:clamp(30px,3.6vw,46px);line-height:1.08;letter-spacing:-0.02em;font-weight:600;color:var(--color-text);margin:0${lead ? ' 0 18px' : ''};text-wrap:balance;`}>{title}</h2>
  {lead && <p style="font-size:18px;line-height:1.6;color:var(--color-body);margin:0;">{lead}</p>}
</div>
