---
// Consulting differentiators, in the site's number/left-accent-bar card style.
const reasons = [
  {
    title: "Two People, No Handoffs",
    description:
      "The people who scope the work are the people who spec it and build it. No account managers, no junior team learning on your dime.",
  },
  {
    title: "40+ Years Combined",
    description:
      "Senior hardware and software experience across industrial systems, embedded development, and manufacturing.",
  },
  {
    title: "Vendor-Neutral",
    description:
      "We don't sell hardware. Recommendations are ranked by payback, not commission — if the right fix is a $200 sensor, that's the proposal.",
  },
  {
    title: "Right-Sized Fixes",
    description:
      "Sometimes it's a full automation cell. Often it's a changeover tweak or an interlock. You get the smallest fix that pays, not the biggest one that sells.",
  },
];
---
<section id="why" class="bg-dark py-24">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-6 h-px bg-accent flex-shrink-0"></div>
        <span class="min-w-0 font-display text-[11px] font-semibold tracking-[0.22em] uppercase text-accent">Why Frontier</span>
      </div>
      <h2
        class="font-display font-extrabold uppercase text-primary mb-4"
        style="font-size: clamp(36px, 4vw, 56px);"
      >Worth The Call</h2>
      <p class="text-muted text-[15px] leading-relaxed">
        A small firm on purpose. You talk to the people doing the work, and the advice
        isn't attached to a hardware catalogue.
      </p>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-px bg-white/7">
      {reasons.map((r, i) => (
        <div class="relative bg-dark p-8 overflow-hidden">
          <div class="absolute left-0 top-0 w-0.5 bg-accent" style="height: 40%;"></div>
          <span class="font-display font-extrabold text-accent text-[13px] tracking-[0.15em] block mb-4">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="font-display font-bold text-[20px] uppercase tracking-[0.05em] text-primary mb-3">
            {r.title}
          </h3>
          <p class="text-muted text-[14px] leading-relaxed">{r.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
