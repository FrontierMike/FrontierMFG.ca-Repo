---
// The engagement spine: SEE -> TARGET -> PROVE. This is how we consult — measure
// first, fix what pays, prove it. BASELINE (our monitoring kit) is the tool inside
// "See", not the headline.
const steps = [
  {
    num: "01",
    key: "See",
    title: "See",
    description: "We start by making production visible. Often that means BASELINE — our own monitoring kit that clamps onto the machines you already run and streams live OEE, downtime, and MTBF to a dashboard on your network, in days, with no PLC changes. Already have the data? We'll work from yours. Either way, the goal is the same: see exactly when each asset runs, stalls, and starves — shift by shift.",
  },
  {
    num: "02",
    key: "Target",
    title: "Target",
    description: "The data ends the guesswork. It shows where money actually leaks — the real constraint, not the one everyone blames — and what each hour of downtime costs. From there we scope the fix and right-size the automation: sometimes a cobot or a hard-automation cell, sometimes just a changeover tweak or a sensor interlock. Every recommendation is ranked by dollars recovered and backed by real production data — so you spend capital where the payback is provable, not where a vendor points.",
  },
  {
    num: "03",
    key: "Prove",
    title: "Prove",
    description: "After the change, the same numbers show before and after — same machines, same math. Throughput, uptime, and OEE move on your data, not in a slide deck. You see the ROI the next shift, and if the monitoring stays in place, the gains hold instead of quietly eroding.",
  },
];
---
<section id="method" class="bg-dark py-24">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-6 h-px bg-accent"></div>
        <span class="font-display text-[11px] font-semibold tracking-[0.22em] uppercase text-accent">How We Work</span>
      </div>
      <h2
        class="font-display font-extrabold uppercase text-primary mb-4"
        style="font-size: clamp(36px, 4vw, 56px);"
      >See → Target → Prove</h2>
      <p class="text-muted text-[15px] leading-relaxed">
        We don't guess. We make production visible, aim the fix where it actually pays,
        and prove the result on the same numbers — automation, controls, or process.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-px bg-white/7">
      {steps.map((step) => (
        <div class="relative bg-dark p-8 overflow-hidden">
          <div class="absolute left-0 top-0 w-0.5 bg-accent" style="height: 40%;"></div>
          <div class="flex items-baseline gap-3 mb-5">
            <span class="font-display font-extrabold text-accent text-[13px] tracking-[0.15em]">{step.num}</span>
            <h3 class="font-display font-extrabold text-[26px] uppercase tracking-[0.05em] text-primary leading-none">{step.title}</h3>
          </div>
          <p class="text-muted text-[14px] leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
