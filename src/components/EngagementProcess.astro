---
// How an engagement runs, start to finish. Lives on /services under the grid.
const steps = [
  {
    num: "01",
    title: "Free Discovery Call",
    description: "A free 30-minute call to understand your operation, constraints, and goals. No commitment, no sales pitch.",
  },
  {
    num: "02",
    title: "Site Assessment",
    description: "Where it helps, we visit the facility to observe processes, audit equipment, and gather the data the decision actually needs.",
  },
  {
    num: "03",
    title: "Proposal & Scope",
    description: "A clear written proposal with defined deliverables, timeline, and fixed or hourly pricing — so you know exactly what you're buying.",
  },
  {
    num: "04",
    title: "Delivery",
    description: "We do the work, keep you informed throughout, and hand over documentation at completion — built to run without us.",
  },
];
---
<section id="process" class="bg-card py-24 border-t border-white/7">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-6 h-px bg-accent"></div>
        <span class="font-display text-[11px] font-semibold tracking-[0.22em] uppercase text-accent">How It Works</span>
      </div>
      <h2
        class="font-display font-extrabold uppercase text-primary mb-4"
        style="font-size: clamp(36px, 4vw, 56px);"
      >Our Process</h2>
      <p class="text-muted text-[15px] leading-relaxed">
        Low-risk by design. You find out whether the work is worth doing before you spend
        a dollar on it.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-white/7">
      {steps.map((step) => (
        <div class="relative bg-card p-8 overflow-hidden">
          <div class="absolute left-0 top-0 w-0.5 bg-accent" style="height: 40%;"></div>
          <span class="font-display font-extrabold text-accent text-[13px] tracking-[0.15em] block mb-4">{step.num}</span>
          <h3 class="font-display font-bold text-[18px] uppercase tracking-[0.05em] text-primary mb-3 leading-tight">
            {step.title}
          </h3>
          <p class="text-muted text-[14px] leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
