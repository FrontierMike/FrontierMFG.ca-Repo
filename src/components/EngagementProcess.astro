---
// How an engagement runs, start to finish. Used on home and /services.
const steps = [
  {
    num: "1",
    title: "Free discovery call",
    description: "A free 30-minute call to understand your operation, constraints, and goals. No commitment, no sales pitch.",
  },
  {
    num: "2",
    title: "Site assessment",
    description: "Where it helps, we visit the facility to observe processes, audit equipment, and gather the data the decision actually needs.",
  },
  {
    num: "3",
    title: "Proposal & scope",
    description: "A clear written proposal with defined deliverables, timeline, and fixed or hourly pricing — so you know exactly what you're buying.",
  },
  {
    num: "4",
    title: "Delivery",
    description: "We do the work, keep you informed throughout, and hand over documentation at completion — built to run without us.",
  },
];
---
<section id="process" class="bg-tint py-20 md:py-24 border-y border-line">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-12 max-w-2xl">
      <p class="text-[12px] font-semibold tracking-[0.16em] uppercase text-accent mb-3">How it works</p>
      <h2 class="text-ink font-bold mb-4" style="font-size: clamp(30px, 3.5vw, 44px);">Our process</h2>
      <p class="text-muted text-[16px] leading-relaxed">
        Low-risk by design. You find out whether the work is worth doing before you spend
        a dollar on it.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map((step) => (
        <div class="bg-white border border-line rounded-xl p-7 shadow-sm">
          <span class="flex items-center justify-center w-10 h-10 rounded-full border-2 border-accent text-accent font-bold text-[16px] mb-4">{step.num}</span>
          <h3 class="text-ink font-semibold text-[17px] mb-2.5 leading-snug">{step.title}</h3>
          <p class="text-muted text-[14.5px] leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
