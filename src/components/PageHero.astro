---
// Inner-page hero: dark band on the blueprint grid, eyebrow, H1, a dimension
// line under it, lead, and optional buttons (default slot).
import DimensionLine from './DimensionLine.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
const hasButtons = Astro.slots.has('default');
---
<!-- TODO: photo — a real shop-floor photo can sit behind this band later,
     under a dark overlay so the text keeps its contrast. -->
<section class="band-dark blueprint" style="border-bottom:1px solid var(--line);">
  <div class="wrap" style="padding-block:clamp(64px,9vw,120px);">
    <div class="label" style="margin-bottom:22px;">{eyebrow}</div>
    <div style="display:inline-block;max-width:960px;">
      <h1 class="display h1">{title}</h1>
      <DimensionLine class="mt-6" />
    </div>
    {lead && <p class="lead" style={`max-width:660px;margin-top:26px;${hasButtons ? 'margin-bottom:34px;' : ''}`}>{lead}</p>}
    {hasButtons && <div style="display:flex;flex-wrap:wrap;gap:14px;"><slot /></div>}
  </div>
</section>
