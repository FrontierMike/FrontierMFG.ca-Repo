---
// Inner-page hero: eyebrow, H1, lead, and optional buttons (default slot).
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
const hasButtons = Astro.slots.has('default');
---
<section class="dots-hero" style="border-bottom:1px solid var(--border);">
  <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,88px) 32px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:22px;">
      <span style="display:block;width:32px;height:2px;background:var(--color-accent);"></span>
      <span class="eyebrow">{eyebrow}</span>
    </div>
    <h1 style="font-size:clamp(34px,4.8vw,60px);line-height:1.06;letter-spacing:-0.025em;font-weight:600;color:var(--color-text);margin:0 0 22px;max-width:860px;text-wrap:balance;">{title}</h1>
    {lead && <p style={`font-size:18px;line-height:1.6;color:var(--color-body);margin:0${hasButtons ? ' 0 32px' : ''};max-width:640px;`}>{lead}</p>}
    {hasButtons && <div style="display:flex;flex-wrap:wrap;gap:14px;"><slot /></div>}
  </div>
</section>
