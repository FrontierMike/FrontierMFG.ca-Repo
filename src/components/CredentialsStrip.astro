---
// Credentials strip: the background behind the work, as three facts.
// TODO: Mike to write — final credential wording. Any title must show "EIT"
// with equal prominence.
import { Hammer, GraduationCap, Cog } from '@lucide/astro';

const items = [
  { icon: Hammer, label: 'Since 2011', copy: 'Hands-on in the trades: welding, fabrication, and millwrighting.' },
  { icon: GraduationCap, label: 'BCIT', copy: 'Mechanical education at BCIT (British Columbia Institute of Technology).' },
  { icon: Cog, label: 'Custom builds', copy: 'Designing, building, and commissioning custom automation machines.' },
];
---
<ul class="card cred-strip" style="list-style:none;margin:0;padding:0;">
  {items.map((it, i) => {
    const Icon = it.icon;
    return (
      <li data-reveal style={`--reveal-delay:${i * 80}ms;padding:26px 24px;display:flex;gap:16px;align-items:flex-start;${i > 0 ? 'border-left:1px solid var(--line);' : ''}`} class="cred-item">
        <span class="icon-tile" style="flex-shrink:0;"><Icon size={22} stroke-width={1.6} aria-hidden="true" /></span>
        <div>
          <div class="label" style="margin-bottom:6px;">{it.label}</div>
          <p style="margin:0;font-size:15.5px;line-height:1.55;color:var(--text-body);">{it.copy}</p>
        </div>
      </li>
    );
  })}
</ul>

<style>
  /* Three across from 800px; stacked below, with the rule between items
     turning horizontal. */
  .cred-strip { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .cred-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 799.98px) {
    .cred-item { border-left: 0 !important; }
    .cred-item + .cred-item { border-top: 1px solid var(--line); }
  }
</style>
