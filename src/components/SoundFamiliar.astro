---
// Consulting problem band — names the moments a shop actually goes looking for
// a consultant. The BASELINE gut-feel band moved to /baseline.
const pains = [
  "A machine is down and the OEM stopped answering.",
  "The PLC program is a black box — whoever wrote it is long gone.",
  "One manual station eats a full shift of labour every day.",
  "An integrator quote just landed and you can't sanity-check it.",
];
---
<section class="bg-surface border-y border-white/7">
  <div class="max-w-7xl mx-auto px-6 py-14 md:py-16">
    <p class="font-display font-extrabold uppercase text-primary leading-tight mb-8" style="font-size: clamp(24px, 3vw, 40px);">
      Sound <span class="text-accent">familiar</span>?
    </p>
    <div class="grid sm:grid-cols-2 gap-x-10 gap-y-4 max-w-4xl mb-8">
      {pains.map((p) => (
        <p class="text-muted text-[15px] leading-relaxed border-l-2 border-accent/40 pl-4">{p}</p>
      ))}
    </div>
    <p class="text-muted text-[15px] leading-relaxed">
      That's the moment most shops go looking for help.
      <a href="#contact" class="text-primary hover:text-accent transition-colors duration-200">The first call is free →</a>
    </p>
  </div>
</section>
