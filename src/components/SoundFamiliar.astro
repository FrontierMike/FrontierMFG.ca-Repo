---
// Consulting problem band — names the moments a shop actually goes looking for
// a consultant. The BASELINE gut-feel band lives on /baseline.
const pains = [
  "A machine is down and the OEM stopped answering.",
  "The PLC program is a black box — whoever wrote it is long gone.",
  "One manual station eats a full shift of labour every day.",
  "An integrator quote just landed and you can't sanity-check it.",
];
---
<section class="bg-page py-20 md:py-24">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-ink font-bold leading-tight mb-8" style="font-size: clamp(28px, 3vw, 40px);">
      Sound familiar<span class="text-accent">?</span>
    </h2>
    <div class="grid sm:grid-cols-2 gap-4 max-w-4xl mb-8">
      {pains.map((p) => (
        <div class="bg-tint border border-line rounded-lg px-5 py-4 text-muted text-[15px] leading-relaxed">
          {p}
        </div>
      ))}
    </div>
    <p class="text-muted text-[15px] leading-relaxed">
      That's the moment most shops go looking for help.
      <a href="#contact" class="text-accent font-medium hover:text-accent-dark transition-colors duration-200">The first call is free →</a>
    </p>
  </div>
</section>
