---
// What measuring OEE actually buys a manufacturer. Outcomes, not features. Used
// on /what-is-oee as the "why it pays" payoff.
const benefits = [
  {
    title: "Find the downtime nobody logs",
    description:
      "Micro-stoppages, slow cycles, starved machines — the losses that never make it onto a paper report show up on day one.",
  },
  {
    title: "Know what an hour costs",
    description:
      "Put a dollar figure on downtime, per machine. When you know what each hour actually leaks, priorities set themselves.",
  },
  {
    title: "End the shift-vs-shift arguments",
    description:
      "Same machines, same math, every shift. The dashboard settles in seconds what meetings argue about for weeks.",
  },
  {
    title: "Justify capex with evidence",
    description:
      "Walk into the budget meeting with weeks of your own production data — not a vendor brochure and a hunch.",
  },
  {
    title: "Recover capacity you already own",
    description:
      "Most of the gap to world-class OEE is hidden loss, not missing machines. Close it and you get more output from the floor you already have.",
  },
  {
    title: "Your data stays yours",
    description:
      "Measured on your own network, on hardware you own. No cloud lock-in, no subscription holding your numbers hostage.",
  },
];
---
<section id="benefits" class="bg-tint py-20 md:py-24 border-y border-line">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-12 max-w-2xl">
      <p class="text-[12px] font-semibold tracking-[0.16em] uppercase text-accent mb-3">Why measure</p>
      <h2 class="text-ink font-bold mb-4" style="font-size: clamp(30px, 3.5vw, 44px);">What the numbers buy you</h2>
      <p class="text-muted text-[16px] leading-relaxed">
        OEE isn't a number for the sake of a number. It's the difference between arguing
        about the problem and pointing at it — and knowing exactly what it's worth to fix.
      </p>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
      {benefits.map((b) => (
        <div class="bg-white border border-line rounded-xl p-7 shadow-sm">
          <h3 class="text-ink font-semibold text-[17px] mb-2.5">{b.title}</h3>
          <p class="text-muted text-[14.5px] leading-relaxed">{b.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
