---
// ponytail: right-column dashboard is a CSS mock (no image/video asset) — it teases,
// the real looping demo lives in the #dashboard section below.
---
<section class="min-h-screen bg-dark flex items-center pt-16">
  <div class="max-w-7xl mx-auto px-6 w-full py-20 lg:py-0">
    <div class="grid lg:grid-cols-2 gap-12 xl:gap-24 items-center min-h-[calc(100vh-4rem)]">

      <!-- Left content -->
      <div class="flex flex-col justify-center">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-px bg-accent flex-shrink-0"></div>
          <span class="font-display text-[11px] font-semibold tracking-[0.22em] uppercase text-accent">
            Automation & Manufacturing Consulting
          </span>
        </div>

        <h1
          class="font-display font-extrabold uppercase leading-none text-primary mb-6"
          style="font-size: clamp(52px, 6vw, 84px); letter-spacing: 0.02em;"
        >
          You Can't Improve<br />What You Can't <span class="text-accent">See</span>
        </h1>

        <p class="text-muted text-[15px] leading-relaxed mb-10 max-w-[480px]">
          Most shops run on gut feel and guesswork. We start by making your production
          <span class="text-primary">visible</span> — live OEE, downtime, and machine
          status from an unobtrusive kit — then automate the right thing and prove it worked.
        </p>

        <div class="flex flex-wrap items-center gap-6">
          <a
            href="#contact"
            class="bg-accent hover:bg-accent-dark text-dark font-display font-bold text-[13px] tracking-[0.1em] uppercase px-7 py-4 transition-all duration-200 hover:-translate-y-0.5"
          >
            Book a Free Consultation
          </a>
          <a
            href="#dashboard"
            class="font-display font-semibold text-[13px] tracking-[0.1em] uppercase text-muted hover:text-accent transition-colors duration-200"
          >
            See a Live Dashboard ↓
          </a>
        </div>
      </div>

      <!-- Right: dashboard teaser mock on grid backdrop -->
      <div
        class="relative hidden lg:flex items-center justify-center min-h-[520px]"
        style="background-image: repeating-linear-gradient(rgba(232,160,32,0.05) 0px, rgba(232,160,32,0.05) 1px, transparent 1px, transparent 60px), repeating-linear-gradient(90deg, rgba(232,160,32,0.05) 0px, rgba(232,160,32,0.05) 1px, transparent 1px, transparent 60px);"
      >
        <div class="w-full max-w-[420px] bg-surface border border-white/7 shadow-2xl">
          <!-- title bar -->
          <div class="flex items-center justify-between px-5 py-3 border-b border-white/7">
            <span class="font-display text-[11px] font-semibold tracking-[0.15em] uppercase text-muted">Production Overview · CNC-01</span>
            <span class="flex items-center gap-2 font-display text-[10px] font-bold tracking-[0.15em] uppercase text-accent">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span> Live
            </span>
          </div>
          <!-- body -->
          <div class="p-5 grid grid-cols-3 gap-4">
            <!-- OEE big -->
            <div class="col-span-1 flex flex-col justify-center">
              <div class="font-display font-extrabold text-accent leading-none" style="font-size: 2.75rem;">74<span class="text-[1.25rem] align-top">%</span></div>
              <div class="font-display text-[10px] font-semibold tracking-[0.15em] uppercase text-dim mt-2">OEE · 24h</div>
            </div>
            <!-- A / P / Q -->
            <div class="col-span-2 grid grid-cols-3 gap-3">
              {[["A","89%"],["P","88%"],["Q","94%"]].map(([k,v]) => (
                <div class="bg-card border border-white/7 px-2 py-3 text-center">
                  <div class="font-display font-extrabold text-primary text-[18px] leading-none">{v}</div>
                  <div class="font-display text-[9px] font-semibold tracking-[0.15em] uppercase text-dim mt-1.5">{k}</div>
                </div>
              ))}
            </div>
            <!-- state timeline strip -->
            <div class="col-span-3">
              <div class="font-display text-[9px] font-semibold tracking-[0.15em] uppercase text-dim mb-2">Machine State · 14 d</div>
              <div class="flex h-2.5 w-full overflow-hidden rounded-sm">
                <div class="bg-accent" style="width:62%"></div>
                <div class="bg-accent/40" style="width:18%"></div>
                <div class="bg-white/10" style="width:8%"></div>
                <div class="bg-accent" style="width:12%"></div>
              </div>
            </div>
            <!-- mini bars -->
            <div class="col-span-3 flex items-end gap-1.5 h-16 pt-2">
              {[40,55,48,70,62,80,58,74,66,88,72,60].map((h) => (
                <div class="flex-1 bg-accent/70" style={`height:${h}%`}></div>
              ))}
            </div>
            <div class="col-span-3 font-display text-[9px] font-semibold tracking-[0.15em] uppercase text-dim -mt-2">Parts / Day · 14 d</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
