---
// Dark charcoal hero band: sentence-case headline, red held for the key word and
// CTA. Right column is the dashboard mock restyled as a light "real UI" card —
// swap in shop-floor photography here when assets exist.
---
<section class="bg-band pt-16">
  <div class="max-w-7xl mx-auto px-6 w-full py-20 lg:py-0">
    <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center min-h-[calc(100vh-4rem)] max-lg:min-h-0">

      <!-- Left content -->
      <div class="flex flex-col justify-center py-4 lg:py-24">
        <p class="text-[12px] font-semibold tracking-[0.16em] uppercase text-white/50 mb-5">
          Automation &amp; manufacturing consulting · Western Canada
        </p>

        <h1 class="text-white font-bold leading-[1.05] mb-6" style="font-size: clamp(38px, 4.6vw, 62px);">
          Fix the <span class="text-[#e25a4f]">right</span> thing<br class="hidden md:block" />
          on your floor
        </h1>

        <p class="text-white/65 text-[16px] leading-relaxed mb-9 max-w-[480px]">
          Frontier is a hands-on automation and manufacturing consultancy for Western
          Canadian shops. We find where your production actually loses money, fix it —
          automation, controls, or process — and prove the payback in your own numbers.
          Not sure where to start? That's what the first call is for.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#contact"
            class="bg-accent hover:bg-accent-dark text-white font-semibold text-[15px] px-7 py-3.5 rounded-md transition-colors duration-200"
          >
            Book a free consultation
          </a>
          <a
            href="/services"
            class="text-white/70 hover:text-white font-medium text-[15px] px-2 py-3.5 transition-colors duration-200"
          >
            View services →
          </a>
        </div>
      </div>

      <!-- Right: dashboard teaser as a light UI card -->
      <div
        class="relative hidden lg:flex items-center justify-center min-h-[520px]"
        style="background-image: repeating-linear-gradient(rgba(255,255,255,0.04) 0px, rgba(255,255,255,0.04) 1px, transparent 1px, transparent 60px), repeating-linear-gradient(90deg, rgba(255,255,255,0.04) 0px, rgba(255,255,255,0.04) 1px, transparent 1px, transparent 60px);"
      >
        <div class="w-full max-w-[430px] bg-white rounded-xl shadow-2xl overflow-hidden">
          <!-- title bar -->
          <div class="flex items-center justify-between px-5 py-3 border-b border-line bg-tint">
            <span class="text-[12px] font-semibold text-muted">Production overview · CNC-01</span>
            <span class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-accent">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span> Live
            </span>
          </div>
          <!-- body -->
          <div class="p-5 grid grid-cols-3 gap-4">
            <!-- OEE big -->
            <div class="col-span-1 flex flex-col justify-center">
              <div class="font-bold text-accent leading-none" style="font-size: 2.75rem;">74<span class="text-[1.25rem] align-top">%</span></div>
              <div class="text-[11px] font-medium text-dim mt-2">OEE · 24 h</div>
            </div>
            <!-- A / P / Q -->
            <div class="col-span-2 grid grid-cols-3 gap-3">
              {[["Availability","89%"],["Performance","88%"],["Quality","94%"]].map(([k,v]) => (
                <div class="bg-tint border border-line rounded-lg px-2 py-3 text-center">
                  <div class="font-bold text-ink text-[17px] leading-none">{v}</div>
                  <div class="text-[9px] font-medium text-dim mt-1.5 truncate">{k}</div>
                </div>
              ))}
            </div>
            <!-- state timeline strip -->
            <div class="col-span-3">
              <div class="text-[10px] font-medium text-dim mb-2">Machine state · 14 d</div>
              <div class="flex h-2.5 w-full overflow-hidden rounded-full">
                <div class="bg-accent" style="width:62%"></div>
                <div class="bg-accent/40" style="width:18%"></div>
                <div class="bg-line" style="width:8%"></div>
                <div class="bg-accent" style="width:12%"></div>
              </div>
            </div>
            <!-- mini bars -->
            <div class="col-span-3 flex items-end gap-1.5 h-16 pt-2">
              {[40,55,48,70,62,80,58,74,66,88,72,60].map((h) => (
                <div class="flex-1 bg-accent/70 rounded-t-sm" style={`height:${h}%`}></div>
              ))}
            </div>
            <div class="col-span-3 text-[10px] font-medium text-dim -mt-2">Parts / day · 14 d</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
