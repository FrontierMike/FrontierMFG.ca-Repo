---
---
<section id="contact" class="bg-tint py-20 md:py-24 border-t border-line">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-14 xl:gap-20">

      <!-- Left column -->
      <div>
        <p class="text-[12px] font-semibold tracking-[0.16em] uppercase text-accent mb-3">Get in touch</p>
        <h2 class="text-ink font-bold mb-5" style="font-size: clamp(30px, 3.5vw, 44px);">Let's talk</h2>
        <p class="text-muted text-[16px] leading-relaxed mb-10 max-w-sm">
          Tell us about your project. First call is always free — we respond within one business day.
        </p>

        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-4">
            <span class="text-[12px] font-semibold uppercase tracking-[0.08em] text-dim w-24 mt-1 flex-shrink-0">Web</span>
            <span class="text-muted text-[15px]">frontiermfg.ca</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[12px] font-semibold uppercase tracking-[0.08em] text-dim w-24 mt-1 flex-shrink-0">Location</span>
            <span class="text-muted text-[15px]">British Columbia, Canada</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[12px] font-semibold uppercase tracking-[0.08em] text-dim w-24 mt-1 flex-shrink-0">Serving</span>
            <span class="text-muted text-[15px]">Western Canada</span>
          </li>
        </ul>
      </div>

      <!-- Right column: form -->
      <div class="bg-white border border-line rounded-xl shadow-sm p-6 md:p-8">
        <form id="contact-form" class="flex flex-col gap-5" novalidate>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="first-name" class="block text-[13px] font-medium text-muted mb-1.5">First name</label>
              <input
                type="text" id="first-name" name="first-name" required
                placeholder="Mike"
                class="w-full bg-white border border-line rounded-md px-4 py-2.5 text-ink text-[15px] placeholder:text-dim focus:outline-none focus:border-accent/60 focus:ring-2 focus:ring-accent/10 transition-colors"
              />
            </div>
            <div>
              <label for="last-name" class="block text-[13px] font-medium text-muted mb-1.5">Last name</label>
              <input
                type="text" id="last-name" name="last-name" required
                placeholder="Smith"
                class="w-full bg-white border border-line rounded-md px-4 py-2.5 text-ink text-[15px] placeholder:text-dim focus:outline-none focus:border-accent/60 focus:ring-2 focus:ring-accent/10 transition-colors"
              />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-[13px] font-medium text-muted mb-1.5">Email</label>
              <input
                type="email" id="email" name="email" required
                placeholder="you@company.com"
                class="w-full bg-white border border-line rounded-md px-4 py-2.5 text-ink text-[15px] placeholder:text-dim focus:outline-none focus:border-accent/60 focus:ring-2 focus:ring-accent/10 transition-colors"
              />
            </div>
            <div>
              <label for="company" class="block text-[13px] font-medium text-muted mb-1.5">Company</label>
              <input
                type="text" id="company" name="company"
                placeholder="Acme Manufacturing"
                class="w-full bg-white border border-line rounded-md px-4 py-2.5 text-ink text-[15px] placeholder:text-dim focus:outline-none focus:border-accent/60 focus:ring-2 focus:ring-accent/10 transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="service" class="block text-[13px] font-medium text-muted mb-1.5">Service of interest</label>
            <select
              id="service" name="service"
              class="w-full bg-white border border-line rounded-md px-4 py-2.5 text-ink text-[15px] focus:outline-none focus:border-accent/60 focus:ring-2 focus:ring-accent/10 transition-colors appearance-none cursor-pointer"
            >
              <option value="">Select a service...</option>
              <option value="Shop Floor Monitoring / OEE Pilot">Shop floor monitoring / OEE pilot</option>
              <option value="Process Automation">Process automation</option>
              <option value="PLC / SCADA Programming">PLC / SCADA programming</option>
              <option value="Hardware & Software Integration">Hardware &amp; software integration</option>
              <option value="Controls Design">Controls design</option>
              <option value="Manufacturing Process Improvement">Manufacturing process improvement</option>
              <option value="Feasibility Study">Feasibility study</option>
              <option value="Design for Manufacturing">Design for manufacturing</option>
              <option value="Machining Consultation">Machining consultation</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-[13px] font-medium text-muted mb-1.5">Message</label>
            <textarea
              id="message" name="message" rows="5" required
              placeholder="Tell us about your project or challenge..."
              class="w-full bg-white border border-line rounded-md px-4 py-2.5 text-ink text-[15px] placeholder:text-dim focus:outline-none focus:border-accent/60 focus:ring-2 focus:ring-accent/10 transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Honeypot — hidden from humans; bots that fill it are rejected server-side -->
          <div style="position:absolute; left:-9999px;" aria-hidden="true">
            <label for="company-website">Company Website</label>
            <input
              type="text" id="company-website" name="company-website"
              tabindex="-1" autocomplete="off"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-accent hover:bg-accent-dark text-white font-semibold text-[15px] py-3.5 rounded-md transition-colors duration-200 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Send message
          </button>

        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const defaultLabel = button.textContent;

    // Status line, inserted right after the submit button
    const status = document.createElement('p');
    status.className = 'text-[14px] mt-1';
    status.setAttribute('role', 'status');
    button.insertAdjacentElement('afterend', status);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';

      const data = new FormData(form);
      const payload = {
        'first-name':      (data.get('first-name')      as string) || '',
        'last-name':       (data.get('last-name')       as string) || '',
        'email':           (data.get('email')           as string) || '',
        'company':         (data.get('company')         as string) || '',
        'service':         (data.get('service')         as string) || '',
        'message':         (data.get('message')         as string) || '',
        'company-website': (data.get('company-website') as string) || '', // honeypot
      };

      button.disabled = true;
      button.textContent = 'Sending…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json().catch(() => ({ ok: false }));

        if (res.ok && result.ok) {
          form.reset();
          status.className = 'text-[14px] mt-1 text-accent';
          status.textContent = "Thanks — your message has been sent. We'll respond within one business day.";
          button.textContent = 'Message sent';
        } else {
          status.className = 'text-[14px] mt-1 text-red-500';
          status.textContent = result.error || 'Something went wrong. Please email info@frontiermfg.ca directly.';
          button.disabled = false;
          button.textContent = defaultLabel;
        }
      } catch {
        status.className = 'text-[14px] mt-1 text-red-500';
        status.textContent = 'Network error. Please email info@frontiermfg.ca directly.';
        button.disabled = false;
        button.textContent = defaultLabel;
      }
    });
  }
</script>
