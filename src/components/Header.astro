---
interface Props {
  page?: 'home' | 'services' | 'lightwell';
}
const { page = 'home' } = Astro.props;

// Hash links target sections on the home page; prefix with "/" from other pages.
const p = page === 'home' ? '' : '/';
const cta = page === 'lightwell'
  ? { href: '#pilot', label: 'Join the pilot' }
  : { href: `${p}#contact`, label: 'Book a free consultation' };

const active = 'color:var(--color-text);font-size:14px;font-weight:600;';
const idle = 'color:var(--color-body);font-size:14px;font-weight:500;';
const mActive = 'padding:13px 2px;color:var(--color-text);font-size:16px;font-weight:600;border-bottom:1px solid var(--border);';
const mIdle = 'padding:13px 2px;color:var(--color-text);font-size:16px;font-weight:500;border-bottom:1px solid var(--border);';
---
<header style="position:sticky;top:0;z-index:50;background:rgba(19,28,36,0.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);">
  <div style="max-width:1200px;margin:0 auto;padding:0 32px;height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px;">
    <a href="/" style="display:flex;align-items:center;gap:10px;color:var(--color-text);font-weight:700;font-size:19px;letter-spacing:0.01em;">
      <span style="display:inline-block;width:10px;height:10px;background:var(--color-accent);border-radius:2px;transform:rotate(45deg);"></span>
      FRONTIER<span style="color:var(--color-accent-text);">&nbsp;MFG</span>
    </a>
    <nav class="nav-desktop">
      <a href="/services" style={page === 'services' ? active : idle}>Services</a>
      <a href="/lightwell" style={(page === 'lightwell' ? active : idle) + 'display:inline-flex;align-items:center;gap:6px;'}>Lightwell <span class="pill-soon">SOON</span></a>
      <a href={`${p}#process`} style={idle}>Process</a>
      <a href={`${p}#about`} style={idle}>About</a>
      <a href={cta.href} class="btn-red-sm">{cta.label}</a>
    </nav>
    <button id="menu-btn" class="menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span style="display:block;height:2px;width:100%;background:var(--color-surface);border-radius:2px;"></span>
      <span style="display:block;height:2px;width:100%;background:var(--color-surface);border-radius:2px;"></span>
      <span style="display:block;height:2px;width:100%;background:var(--color-surface);border-radius:2px;"></span>
    </button>
  </div>
  <nav id="mobile-menu" class="nav-mobile">
    <a href="/services" style={page === 'services' ? mActive : mIdle}>Services</a>
    <a href="/lightwell" style={(page === 'lightwell' ? mActive : mIdle) + 'display:inline-flex;align-items:center;gap:8px;'}>Lightwell <span class="pill-soon">SOON</span></a>
    <a href={`${p}#process`} style={mIdle}>Process</a>
    <a href={`${p}#about`} style={mIdle}>About</a>
    <a href={cta.href} class="btn-red" style="margin-top:14px;font-size:15px;padding:14px;">{cta.label}</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
