---
import { Menu } from '@lucide/astro';
import { getCaseStudies } from '../data/content';

// Case Studies joins the nav on its own once the first one is published.
const caseStudies = await getCaseStudies();

const links = [
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/services', label: 'Services' },
  { href: '/learn', label: 'Learn' },
  ...(caseStudies.length > 0 ? [{ href: '/case-studies', label: 'Case Studies' }] : []),
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="band-dark" style="position:sticky;top:0;z-index:50;background:rgb(21 24 27 / 0.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);">
  <div class="wrap" style="height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px;">
    <a href="/" aria-label="Frontier MFG home" style="display:flex;align-items:center;gap:10px;color:var(--text);font-family:var(--font-display);font-weight:700;font-size:24px;letter-spacing:0.04em;">
      <span aria-hidden="true" style="display:inline-block;width:11px;height:11px;background:var(--color-safety);transform:rotate(45deg);"></span>
      FRONTIER<span style="color:var(--color-safety);">MFG</span>
    </a>
    <nav class="nav-desktop" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="nav-link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/contact" class="btn btn-primary btn-sm">Book an Assessment</a>
    </nav>
    <button id="menu-btn" class="menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <Menu size={22} stroke-width={1.75} aria-hidden="true" />
    </button>
  </div>
  <nav id="mobile-menu" class="nav-mobile" aria-label="Main">
    {links.map((l) => (
      <a href={l.href} class="nav-row" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href="/contact" class="btn btn-primary" style="margin-top:16px;">Book an Assessment</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
