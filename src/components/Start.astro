---
// The page's conversion point. Consulting (available now) is the primary card;
// the BASELINE pilot (coming soon) is the secondary path.
---
<section id="start" class="bg-page py-20 md:py-24">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-12 max-w-2xl">
      <p class="text-[12px] font-semibold tracking-[0.16em] uppercase text-accent mb-3">Two ways to start</p>
      <h2 class="text-ink font-bold mb-4" style="font-size: clamp(30px, 3.5vw, 44px);">Start with a conversation</h2>
      <p class="text-muted text-[16px] leading-relaxed">
        Book a free call and talk through the problem — no commitment, no sales pitch. Or
        get on the list for a low-commitment monitoring pilot when spots open.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">

      <!-- Consulting now (primary) -->
      <div class="relative bg-white border border-line rounded-xl shadow-sm p-8 md:p-10 flex flex-col overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-accent"></div>
        <div class="flex items-center gap-3 mb-4">
          <h3 class="text-ink font-bold text-[22px]">Consulting</h3>
          <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-accent bg-accent/8 rounded-full px-3 py-1">Available now</span>
        </div>
        <p class="text-[13px] font-semibold text-accent mb-4">Automation, controls &amp; process</p>
        <p class="text-muted text-[15.5px] leading-relaxed mb-6">
          The full spectrum, from automation and controls to process. A free 30-minute
          call to scope it, then a clear written proposal. No commitment to find out if
          it's worth doing.
        </p>
        <ul class="flex flex-col gap-2.5 mb-8">
          {[
            "Free 30-minute discovery call",
            "Written proposal, fixed or hourly",
            "Two people who build what they spec",
          ].map((f) => (
            <li class="flex items-start gap-3 text-muted text-[15px] leading-relaxed">
              <span class="text-accent font-bold mt-0.5 flex-shrink-0">→</span>{f}
            </li>
          ))}
        </ul>
        <div class="mt-auto flex flex-wrap items-center gap-5">
          <a
            href="#contact"
            class="inline-flex items-center bg-accent hover:bg-accent-dark text-white font-semibold text-[15px] px-6 py-3 rounded-md transition-colors duration-200"
          >
            Book a free consultation
          </a>
          <a
            href="/services"
            class="text-muted hover:text-accent font-medium text-[14px] transition-colors"
          >
            See all services →
          </a>
        </div>
      </div>

      <!-- BASELINE pilot (coming soon) -->
      <div class="bg-white border border-line rounded-xl shadow-sm p-8 md:p-10 flex flex-col">
        <div class="flex items-center gap-3 mb-4">
          <h3 class="text-ink font-bold text-[22px]">BASELINE</h3>
          <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-muted bg-tint border border-line rounded-full px-3 py-1">Pilot — coming soon</span>
        </div>
        <p class="text-[13px] font-semibold text-muted mb-4">The monitoring pilot</p>
        <p class="text-muted text-[15.5px] leading-relaxed mb-6">
          BASELINE is our manufacturing IoT platform — a small kit on one or more machines,
          streaming live OEE, downtime, and MTBF to a dashboard in days. Get on the list to
          see what you've been missing before you commit to anything bigger.
        </p>
        <ul class="flex flex-col gap-2.5 mb-8">
          {[
            "Live OEE, downtime & MTBF in days",
            "No PLC changes, no line stoppage",
            "Your data stays on your network",
          ].map((f) => (
            <li class="flex items-start gap-3 text-muted text-[15px] leading-relaxed">
              <span class="text-accent font-bold mt-0.5 flex-shrink-0">→</span>{f}
            </li>
          ))}
        </ul>
        <div class="mt-auto flex flex-wrap items-center gap-5">
          <a
            href="#contact"
            class="inline-flex items-center border-2 border-accent text-accent hover:bg-accent hover:text-white font-semibold text-[15px] px-6 py-[10px] rounded-md transition-colors duration-200"
          >
            Join the pilot list →
          </a>
          <a
            href="/baseline"
            class="text-muted hover:text-accent font-medium text-[14px] transition-colors"
          >
            Learn more →
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
