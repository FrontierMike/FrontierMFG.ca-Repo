---
// Home teaser for the full /services page. Consulting-first ordering.
const services = [
  "Process automation",
  "PLC / SCADA programming",
  "Controls design",
  "Hardware & software integration",
  "Process improvement",
  "Feasibility studies",
  "Design for manufacturing",
  "Machining consultation",
];
---
<section id="services" class="bg-tint py-20 md:py-24 border-y border-line">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-10 max-w-2xl">
      <p class="text-[12px] font-semibold tracking-[0.16em] uppercase text-accent mb-3">What we do</p>
      <h2 class="text-ink font-bold mb-4" style="font-size: clamp(30px, 3.5vw, 44px);">Services</h2>
      <p class="text-muted text-[16px] leading-relaxed">
        Hands-on help across the full spectrum — from automation and controls to process
        improvement and shop-floor monitoring. Available now for manufacturers across
        Western Canada.
      </p>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-3 mb-10">
      {services.map((title, i) => (
        <li class="flex items-baseline gap-3 bg-white border border-line rounded-lg px-4 py-3">
          <span class="text-[12px] font-bold text-accent">{String(i + 1).padStart(2, "0")}</span>
          <span class="text-ink font-medium text-[15px]">{title}</span>
        </li>
      ))}
    </ul>

    <div class="flex flex-wrap items-center gap-5">
      <a
        href="/services"
        class="inline-flex items-center bg-accent hover:bg-accent-dark text-white font-semibold text-[15px] px-6 py-3 rounded-md transition-colors duration-200"
      >
        Explore all services →
      </a>
      <a
        href="#contact"
        class="text-muted hover:text-accent font-medium text-[15px] transition-colors duration-200"
      >
        Already know your problem? Book a free call →
      </a>
    </div>

  </div>
</section>
