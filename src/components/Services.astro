---
// Condensed to a strip: consulting is the upsell once BASELINE finds the problem.
// ponytail: was 9 icon cards — full grid lives in git history if it's ever wanted back.
const services = [
  "Process Improvement",
  "Feasibility Studies",
  "Process Automation",
  "PLC / SCADA Programming",
  "Controls Design",
  "Hardware & Software Integration",
  "Design for Manufacturing",
  "Machining Consultation",
];
---
<section id="services" class="bg-card py-20 border-t border-white/7">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-10 max-w-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-6 h-px bg-accent"></div>
        <span class="font-display text-[11px] font-semibold tracking-[0.22em] uppercase text-accent">When The Data Finds It</span>
      </div>
      <h2
        class="font-display font-extrabold uppercase text-primary mb-4"
        style="font-size: clamp(36px, 4vw, 56px);"
      >We Fix It Too</h2>
      <p class="text-muted text-[15px] leading-relaxed">
        BASELINE finds the problem — and we cover the fix. The full spectrum, from
        process improvement to hands-on automation and controls.
      </p>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-4 mb-10">
      {services.map((title, i) => (
        <li class="flex items-baseline gap-3 border-l-2 border-accent/40 pl-4 py-1">
          <span class="font-display text-[11px] font-semibold tracking-[0.15em] text-dim">{String(i + 1).padStart(2, "0")}</span>
          <span class="font-display font-bold text-[15px] uppercase tracking-[0.05em] text-primary">{title}</span>
        </li>
      ))}
    </ul>

    <a
      href="#contact"
      class="font-display font-semibold text-[13px] tracking-[0.1em] uppercase text-muted hover:text-accent transition-colors duration-200"
    >
      Already know your problem? Book a free call →
    </a>

  </div>
</section>
