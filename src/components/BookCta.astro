---
// Closing call to action: Book a Productivity Assessment. Ends every page
// except Contact. Anything in the default slot renders under the button.
import { ArrowRight } from '@lucide/astro';

interface Props {
  id?: string;
  title?: string;
  copy?: string;
}
const {
  id,
  title = 'Start with your own numbers.',
  copy = 'A Productivity Assessment shows where your time and output are going, and what automation would pay back. It starts with a walk of your floor.',
} = Astro.props;
---
<section id={id} class="band-dark">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap" style="padding-block:clamp(80px,10vw,128px);text-align:center;">
    <div data-reveal style="max-width:760px;margin-inline:auto;">
      <div class="label" style="margin-bottom:18px;">Next step</div>
      <h2 class="display h2">{title}</h2>
      <p class="lead" style="margin:20px auto 36px;max-width:600px;">{copy}</p>
      <a href="/contact" class="btn btn-primary" style="font-size:17px;padding:17px 30px;">Book a Productivity Assessment <ArrowRight class="arrow" size={18} stroke-width={2} aria-hidden="true" /></a>
      <div class="label-muted" style="display:flex;align-items:center;justify-content:center;gap:9px;margin-top:20px;"><span aria-hidden="true" style="display:inline-block;width:7px;height:7px;border-radius:100px;background:var(--color-ok);"></span> We reply within one business day</div>
      <slot />
    </div>
  </div>
</section>
